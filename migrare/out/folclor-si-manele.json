{"meta": {"src": "folclor-si-manele.html", "slug": "folclor-si-manele", "parent": null, "noindex": false, "seo_title": "Folclor și manele în aceeași seară, la cerere | Ioana Balan", "metadesc": "Cum intră manelele în programul serii: în blocul de petrecere, la cererea gazdelor, după jocurile populare și hora mare, stabilite la discuția de organizare.", "jsonld": [{"@context": "https://schema.org", "@type": "Service", "name": "Folclor și manele în programul de petrecere", "serviceType": "Muzică de petrecere: folclor, manele, muzică balcanică și muzică ușoară", "description": "Program muzical care pune în aceeași seară jocurile populare și blocul de petrecere, în care intră la cererea gazdelor manele, muzică balcanică și muzică ușoară de ring, stabilite la discuția de organizare.", "provider": {"@type": "MusicGroup", "@id": "https://ioana-balan.ro/#artist", "name": "Ioana Balan", "url": "https://ioana-balan.ro/", "genre": ["Muzică populară", "Muzică de petrecere", "Folclor", "Manele", "Muzică balcanică", "Muzică ușoară"], "foundingLocation": {"@type": "Place", "name": "București, România"}, "telephone": "+40722911485", "email": "ioanabalanoficial@gmail.com", "sameAs": ["https://www.facebook.com/ioanabalanoficial", "https://www.instagram.com/ioanabalanoficial/", "https://www.tiktok.com/@ioanabalanmusic", "https://www.youtube.com/channel/UCNTWODu5imMryMhkbbw6vEQ", "https://ro.pinterest.com/ioanabalanoficial/"]}, "availableChannel": {"@type": "ServiceChannel", "servicePhone": {"@type": "ContactPoint", "telephone": "+40722911485", "contactType": "rezervări"}, "serviceUrl": "https://wa.me/40722911485"}}], "h1": "Folclor și manele în aceeași seară: cum se construiește blocul de petrecere", "title": "Folclor și petrecere"}, "elements": [{"id": "folc008", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0