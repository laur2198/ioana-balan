_globals__": {"text_color": "globals/colors?id=secondary", "typography_typography": "globals/typography?id=text"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": []}], "isInner": true}, {"id": "folc019", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><div class=\"max-w-3xl mb-10 md:mb-12\">\n<h3 class=\"font-headline-md text-xl md:text-headline-md leading-snug mb-5\">Decizii despre blocul de petrecere</h3>\n<ul class=\"motif-list flex flex-col gap-3\">\n<li class=\"font-body-md text-body-md\">Ce registre intră în strat și care rămân pe dinafară — manelele, balcanicul și muzica ușoară pot lipsi fiecare, independent de celelalte.</li>\n<li class=\"font-body-md text-body-md\">După ce moment al serii începe blocul și cât rulează până la setul DJ.</li>\n<li class=\"font-body-md text-body-md\">Piesele care nu se cântă deloc, dacă gazdele au o asemenea listă.</li>\n<li class=\"font-body-md text-body-md\">Dedicațiile care trebuie pregătite și cui se adresează.</li>\n<li class=\"font-body-md text-body-md\">Dacă manelele le cântă un interpret separat și cât din bloc îi revine.</li>\n</ul>\n</div></div>"}, "elements": []}, {"id": "folc01a", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><div class=\"grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-gutter max-w-5xl\">\n<article class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Configurație</span>\n<h3 class=\"font-headline-md text-xl md:text-headline-md leading-snug\">Pachetul pe care se sprijină blocul</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Numărul de voci și de instrumente vine din pachet, iar registrul balcanic cu voce separată ține de configurația extinsă. Cifrele sunt pe pagina de oferte.</p>\n<p class=\"mt-auto pt-2\"><a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex items-center gap-2 min-h-[44px]\" href=\"/oferte/\">Compară pachetele și prețurile <svg aria-hidden=\"true\" class=\"text-[18px]\" fill=\"currentColor\" height=\"1em\" style=\"vertical-align:-.125em\" viewbox=\"0 -960 960 960\" width=\"1em\"><path d=\"M693.69-457.31H180v-45.38h513.69L448.39-748 480-780l300 300-300 300-31.61-32 245.3-245.31Z\"></path></svg></a></p>\n</article>\n<article class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Straturi</span>\n<h3 class=\"font-headline-md text-xl md:text-headline-md leading-snug\">Ce rămâne pentru jocurile populare</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Blocul de petrecere se construiește în jurul blocului regional, nu în locul lui. Straturile programului și jocurile fiecărei zone etnografice sunt pe pagina de repertoriu.</p>\n<p class=\"mt-auto pt-2\"><a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex items-center gap-2 min-h-[44px]\" href=\"/repertoriu/\">Vezi straturile și zonele <svg aria-hidden=\"true\" class=\"text-[18px]\" fill=\"currentColor\" height=\"1em\" style=\"vertical-align:-.125em\" viewbox=\"0 -960 960 960\" width=\"1em\"><path d=\"M693.69-457.31H180v-45.38h513.69L448.39-748 480-780l300 300-300 300-31.61-32 245.3-245.31Z\"></path></svg></a></p>\n</article>\n<article class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Componență</span>\n<h3 class=\"font-headline-md text-xl md:text-headline-md leading-snug\">Cine cântă și ce se poate adăuga</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Rolul fiecărui instrument și al fiecărei voci, plus elementele opționale — țambalul, interpretul de muzică balcanică, interpretul de manele — sunt descrise pe pagina formației.</p>\n<p class=\"mt-auto pt-2\"><a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex items-center gap-2 min-h-[44px]\" href=\"/formatia/\">Vezi componența și opționalele <svg aria-hidden=\"true\" class=\"text-[18px]\" fill=\"currentColor\" height=\"1em\" style=\"vertical-align:-.125em\" viewbox=\"0 -960 960 960\" width=\"1em\"><path d=\"M693.69-457.31H180v-45.38h513.69L448.39-748 480-780l300 300-300 300-31.61-32 245.3-245.31Z\"></path></svg></a></p>\n</article>\n<article class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Deplasare</span>\n<h3 class=\"font-headline-md text-xl md:text-headline-md leading-snug\">Dacă evenimentul e departe</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Transportul se calculează pe distanță, iar de la un anumit prag se adaugă cazarea echipei. Pagina de zone arată județele deservite și regula de calcul.</p>\n<p class=\"mt-auto pt-2\"><a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex items-center gap-2 min-h-[44px]\" href=\"/zone/\">Vezi zonele deservite <svg aria-hidden=\"true\" class=\"text-[18px]\" fill=\"currentColor\" height=\"1em\" style=\"vertical-align:-.125em\" viewbox=\"0 -960 960 960\" width=\"1em\"><path d=\"M693.69-457.31H180v-45.38h513.69L448.39-748 480-780l300 300-300 300-31.61-32 245.3-245.31Z\"></path></svg></a></p>\n</article>\n</div></div>"}, "elements": []}], "isInner": false}, {"id": "folc01d", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_backgro