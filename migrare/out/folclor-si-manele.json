ont_weight": "600", "typography_text_transform": "uppercase", "typography_letter_spacing": {"unit": "em", "size": 0.2, "sizes": []}, "typography_line_height": {"unit": "px", "size": 20, "sizes": []}, "__globals__": {"title_color": "globals/colors?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}}, "elements": []}, {"id": "folc027", "elType": "widget", "widgetType": "heading", "settings": {"title": "Întrebări despre manele în programul serii", "header_size": "h2", "title_color": "#E5E2E1", "__globals__": {"title_color": "globals/colors?id=primary", "typography_typography": "globals/typography?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "_element_id": "faq-titlu"}, "elements": []}], "isInner": true}, {"id": "folc02d", "elType": "container", "settings": {"container_type": "flex", "content_width": "full", "flex_direction": "column", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "width": {"unit": "px", "size": 768, "sizes": []}, "width_mobile": {"unit": "%", "size": 100, "sizes": []}, "custom_css": "selector{max-width:100%}", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": [{"id": "folc029", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"faq-item\"><details open><summary aria-expanded=\"true\"><h3>Manelele fac parte din program oricum sau doar la cerere?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 -960 960 960\" fill=\"currentColor\"><path d=\"M480-357.85 253.85-584l32.61-32.61L480-423.08l193.54-193.53L706.15-584 480-357.85Z\"/></svg></summary><div class=\"faq-item__answer\"><p>Doar la cerere. Intră în desfășurător dacă gazdele le cer la discuția de organizare; dacă nu le cer, programul nu le conține. Proporția și momentul se hotărăsc tot atunci.</p></div></details></div>", "custom_css": "selector{margin-bottom:16px}selector h3{margin:0;padding-right:16px;font-family:\"EB Garamond\",Georgia,serif;font-size:16px;font-weight:500;line-height:1.375;color:var(--e-global-color-primary)}@media(min-width:768px){selector h3{font-size:24px}}selector .faq-item__answer{font-family:Inter,sans-serif;font-size:16px;line-height:1.6}selector .faq-item__answer p{margin:0}selector .faq-item__answer p+p{margin-top:12px}"}, "elements": []}, {"id": "folc02a", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"faq-item\"><details><summary aria-expanded=\"false\"><h3>Se cântă live sau le pune DJ-ul?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 -960 960 960\" fill=\"currentColor\"><path d=\"M480-357.85 253.85-584l32.61-32.61L480-423.08l193.54-193.53L706.15-584 480-357.85Z\"/></svg></summary><div class=\"faq-item__answer\"><p>Împărțirea dintre programul live și setul DJ pentru acest registru: <span class=\"ph\">[MANELE: LIVE, DJ SAU AMBELE — de confirmat]</span>.</p></div></details></div>", "custom_css": "selector{margin-bottom:16px}selector h3{margin:0;padding-right:16px;font-family:\"EB Garamond\",Georgia,serif;font-size:16px;font-weight:500;line-height:1.375;color:var(--e-global-color-primary)}@media(min-width:768px){selector h3{font-size:24px}}selector .faq-item__answer{font-family:Inter,sans-serif;font-size:16px;line-height:1.6}selector .faq-item__answer p{margin:0}selector .faq-item__answer p+p{margin-top:12px}"}, "elements": []}, {"id": "folc02b", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"faq-item\"><details><summary aria-expanded=\"false\"><h3>Dacă vrem manele, mai rămâne loc pentru jocurile populare?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 -960 960 960\" fill=\"currentColor\"><path d=\"M480-357.85 253.85-584l32.61-32.61L480-423.08l193.54-193.53L706.15-584 480-357.85Z\"/></svg></summary><div class=\"faq-item__answer\"><p>Da. Blocul regional și hora mare rămân la locul lor, mai devreme în seară. Stratul de petrecere vine după ele și nu le scurtează decât dacă gazdele hotărăsc altfel.</p></div></details></div>", "custom_css": "selector{margin-bottom:16px}selector h3{margin:0;padding-right:16px;font-family:\"EB Garamond\",Georgia,serif;font-size:16px;font-weight:500;line-height:1.375;color:var(--e-global-color-primary)}@media(min-width:768px){selector h3{font-size:24px}}selector .faq-item__answer{font-family:Inter,sans-serif;font-size:16px;line-height:1.6}selector .faq-item__answer p{margin:0}selector .faq-item__answer p+p{margin-top:12px}"}, "elements": []}, {"id": "folc02c", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"faq-item\"><details><summary aria-expanded=\"false\"><h3>O parte din familie nu vrea manele. Cum se împacă cele două tabere?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 -960 960 960\" fill=\"currentColor\"><path d=\"M480-357.85 253.85-584l32.61-32.61L480-423.08l193.54-193.53L706.15-584 480-357.85Z\"/></svg></summary><div class=\"faq-item__answer\"><p>Prin ordine și prin dozaj. Manelele pot rămâne pentru partea târzie a serii, când pe ring e publicul care le vrea, pot fi doar câteva, cu dedicație, sau pot lipsi cu totul. Compromisul se face la discuția de organizare, nu pe ring.</p></div></details></div>", "custom_css": "selector{margin-bottom:16px}selector h3{margin:0;padding-right:16px;font-family:\"EB Garamond\",Georgia,serif;font-size:16px;font-weight:500;line-height:1.375;color:var(--e-global-color-primary)}@media(min-width:768px){selector h3{font-size:24px}}selector .faq-item__answer{font-family:Inter,sans-serif;font-size:1