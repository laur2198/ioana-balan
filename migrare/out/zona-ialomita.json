m_css": "selector p{margin:0}selector{max-width:576px}", "__globals__": {"text_color": "globals/colors?id=secondary", "typography_typography": "globals/typography?id=text"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": []}], "isInner": true}, {"id": "zial008", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><div class=\"flex flex-col sm:flex-row gap-4\">\n<a class=\"inline-block text-center whitespace-nowrap bg-accent text-white px-8 md:px-10 py-4 uppercase font-label-md text-label-md tracking-widest hover:bg-accent-hover transition-colors w-full sm:w-auto\" href=\"https://wa.me/40722911485?text=Bun%C4%83%20ziua%21%20Organizez%20un%20eveniment%20%C3%AEn%20jude%C8%9Bul%20Ialomi%C8%9Ba%20%C8%99i%20a%C8%99%20dori%20s%C4%83%20verific%20disponibilitatea.\" rel=\"noopener\" target=\"_blank\">Verifică data pe WhatsApp</a>\n<a class=\"btn-secundar-zona inline-block text-center whitespace-nowrap text-on-surface bg-transparent px-8 md:px-10 py-4 uppercase font-label-md text-label-md tracking-widest hover:bg-white/5 transition-colors w-full sm:w-auto\" href=\"tel:+40722911485\">+40 722 911 485</a>\n</div></div>"}, "elements": []}, {"id": "zial009", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><span class=\"ph\">Imagine provizorie — se înlocuiește cu fotografie din județul Ialomița (peisaj, min. 1440 px lățime, subiect în treimea centrală)</span></p>", "text_color": "#C6C6C6", "custom_css": "selector p{margin:0}", "__globals__": {"text_color": "globals/colors?id=secondary", "typography_typography": "globals/typography?id=text"}, "_margin": {"unit": "px", "top": "24", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "24", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "24", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "el