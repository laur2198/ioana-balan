{"meta": {"src": "zone.html", "slug": "zone", "parent": null, "noindex": false, "seo_title": "Zone Deservite — 20 de Județe | Muzică Live pentru Evenimente | Ioana Balan", "metadesc": "Douăzeci de județe din Muntenia, Oltenia, Moldova, Dobrogea și Ardeal, cu plecare din București. Repertoriul se construiește pe zona în care are loc evenimentul.", "jsonld": [{"@context": "https://schema.org", "@type": "Service", "name": "Muzică de petrecere și folclor live pentru evenimente, în 20 de județe", "serviceType": "Muzică live pentru nuntă, botez și eveniment corporate", "description": "Muzică de petrecere și folclor live pentru nunți, botezuri și evenimente corporate, cu deplasare din București în douăzeci de județe din Muntenia, Oltenia, Moldova, Dobrogea și Ardeal.", "areaServed": [{"@type": "AdministrativeArea", "name": "Județul Ilfov"}, {"@type": "AdministrativeArea", "name": "Județul Giurgiu"}, {"@type": "AdministrativeArea", "name": "Județul Prahova"}, {"@type": "AdministrativeArea", "name": "Județul Dâmbovița"}, {"@type": "AdministrativeArea", "name": "Județul Tulcea"}, {"@type": "AdministrativeArea", "name": "Județul Vâlcea"}, {"@type": "AdministrativeArea", "name": "Județul Galați"}, {"@type": "AdministrativeArea", "name": "Județul Mehedinți"}, {"@type": "AdministrativeArea", "name": "Județul Olt"}, {"@type": "AdministrativeArea", "name": "Județul Brăila"}, {"@type": "AdministrativeArea", "name": "Județul Bacău"}, {"@type": "AdministrativeArea", "name": "Județul Vrancea"}, {"@type": "AdministrativeArea", "name": "Județul Teleorman"}, {"@type": "AdministrativeArea", "name": "Județul Călărași"}, {"@type": "AdministrativeArea", "name": "Județul Ialomița"}, {"@type": "AdministrativeArea", "name": "Județul Buzău"}, {"@type": "AdministrativeArea", "name": "Județul Argeș"}, {"@type": "AdministrativeArea", "name": "Județul Brașov"}, {"@type": "AdministrativeArea", "name": "Județul Constanța"}, {"@type": "AdministrativeArea", "name": "Județul Dolj"}], "provider": {"@type": "MusicGroup", "@id": "https://ioana-balan.ro/#artist", "name": "Ioana Balan", "url": "https://ioana-balan.ro/", "genre": ["Muzică populară", "Muzică de petrecere", "Folclor"], "foundingLocation": {"@type": "Place", "name": "București, România"}, "telephone": "+40722911485", "email": "ioanabalanoficial@gmail.com", "sameAs": ["https://www.facebook.com/ioanabalanoficial", "https://www.instagram.com/ioanabalanoficial/", "https://www.tiktok.com/@ioanabalanmusic", "https://www.youtube.com/channel/UCNTWODu5imMryMhkbbw6vEQ", "https://ro.pinterest.com/ioanabalanoficial/"]}, "availableChannel": {"@type": "ServiceChannel", "servicePhone": {"@type": "ContactPoint", "telephone": "+40722911485", "contactType": "rezervări"}, "serviceUrl": "https://wa.me/40722911485"}}], "h1": "Unde cântăm: 20 de județe din cinci zone etnografice", "title": "Zone deservite"}, "elements": [{"id": "zone008", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "__globals__": {}, "custom_css": "selector{border-bottom:1px solid rgba(68,71,72,.1)}selector{background-position:center 6%}", "padding": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}, "background_image": {"url": "{{IMG:ioana-balan-scena-costum-rosu}}", "id": "{{IMGID:ioana-balan-scena-costum-rosu}}", "size": "", "alt": "", "source": "library"}, "background_size": "cover", "background_position": "center center", "background_overlay_background": "gradient", "background_overlay_color": "#131313", "background_overlay_opacity": {"unit": "px", "size": 1, "sizes": []}, "background_overlay_color_stop": {"unit": "%", "size": 0, "sizes": []}, "background_overlay_color_b": "rgba(19,19,19,0.72)", "background_overlay_color_b_stop": {"unit": "%", "size": 100, "sizes": []}, "background_overlay_gradient_type": "linear", "background_overlay_gradient_angle": {"unit": "deg", "size": 0, "sizes": []}, "_element_id": "hero"}, "elements": [{"id": "zone007", "elType": "container", "settings": {"container_type": "flex", "content_width": "full", "flex_direction": "column", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "width": {"unit": "px", "size": 768, "sizes": []}, "width_mobile": {"unit": "%", "size": 100, "sizes": []}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "custom_css": "selector{max-width:100%}"}, "elements": [{"id": "zone001", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><p class=\"font-label-md text-label-md uppercase tracking-[0.2em] mb-4\">\n<span class=\"zona-badge inline-block px-3 py-1.5 text-secondary\">Acoperire</span>\n</p></div>"}, "elements": []}, {"id": "zone002", "elType": "widget", "widgetType": "heading", "settings": {"title": "Unde cântăm: 20 de județe din cinci zone etnografice", "header_size": "h1", "title_color": "#E5E2E1", "__globals__": {"title_color": "globals/colors?id=primary", "typography_typography": "globals/typography?id=primary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "20", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "20", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "20", "left": "0", "isLinked": false}, "_element_id": "hero-titlu"}, "elements": []}, {"id": "zone003", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Plecarea e din București, iar raza de deplasare merge de la 20 de kilometri până la aproximativ 340 — tot sudul țării, Moldova de sub munte, și un singur urcuș peste Carpați, la Brașov. Pe drumul ăsta intră cinci zone etnografice: Muntenia, Oltenia, Moldova, Dobrogea și Ardealul. Nu sunt interschimbabile, iar programul nu se copiază de la una la alta: repertoriul se construiește pe zona în care are loc evenimentul, pentru că ringul răspunde la jocurile pe care le știe, nu la un set unic de piese.</p>", "text_color": "#C6C6C6", "custom_css": "selector p{margin:0}selector{max-width:672px !important}", "__globals__": {"text_color": "globals/colors?id=secondary", "typography_typography": "globals/typography?id=quote"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "32", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "32", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "32", "left": "0", "isLinked": false}}, "elements": []}, {"id": "zone004", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><div class=\"flex flex-col sm:flex-row gap-4\">\n<a class=\"inline-block text-center whitespace-nowrap bg-accent text-white px-8 md:px-10 py-4 uppercase font-label-md text-label-md tracking-widest hover:bg-accent-hover transition-colors w-full sm:w-auto\" href=\"https://wa.me/40722911485?text=Bun%C4%83%20ziua%21%20A%C8%99%20dori%20s%C4%83%20%C8%99tiu%20dac%C4%83%20acoperi%C8%9Bi%20zona%20%C3%AEn%20care%20organizez%20evenimentul.\" rel=\"noopener\" target=\"_blank\">Întreabă pe WhatsApp</a>\n<a class=\"btn-secundar-zona inline-block text-center whitespace-nowrap text-on-surface bg-transparent px-8 md:px-10 py-4 uppercase font-label-md text-label-md tracking-widest hover:bg-white/5 transition-colors w-full sm:w-auto\" href=\"tel:+40722911485\">+40 722 911 485</a>\n</div></div>"}, "elements": []}, {"id": "zone005", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><span class=\"ph\">Imagine provizorie — se înlocuiește cu fotografie de scenă sau de eveniment (peisaj, min. 1440 px lățime, subiect în treimea centrală)</span></p>", "text_color": "#C6C6C6", "custom_css": "selector p{margin:0}", "__globals__": {"text_color": "globals/colors?id=secondary", "typography_typography": "globals/typography?id=text"}, "_margin": {"unit": "px", "top": "24", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "24", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "24", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": []}, {"id": "zone006", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><div class=\"motif-separator w-24 md:w-36 mt-10\"></div></div>"}, "elements": []}], "isInner": true}], "isInner": false}, {"id": "zone00e", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}}, "elements": [{"id": "zone00c", "elType": "container", "settings": {"container_type": "flex", "content_width": "full", "flex_direction": "column", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "width": {"unit": "px", "size": 768, "sizes": []}, "width_mobile": {"unit": "%", "size": 100, "sizes": []}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "48", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "48", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "32", "left": "0", "isLinked": false}, "custom_css": "selector{max-width:100%}"}, "elements": [{"id": "zone009", "elType": "widget", "widgetType": "heading", "settings": {"title": "Județe", "header_size": "div", "title_color": "#C6C6C6", "typography_typography": "custom", "typography_font_family": "Inter", "typography_font_size": {"unit": "px", "size": 14, "sizes": []}, "typography_font_weight": "600", "typography_text_transform": "uppercase", "typography_letter_spacing": {"unit": "em", "size": 0.2, "sizes": []}, "typography_line_height": {"unit": "px", "size": 20, "sizes": []}, "__globals__": {"title_color": "globals/colors?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}}, "elements": []}, {"id": "zone00a", "elType": "widget", "widgetType": "heading", "settings": {"title": "Cele douăzeci de județe, de la cel mai apropiat la cel mai depărtat", "header_size": "h2", "title_color": "#E5E2E1", "__globals__": {"title_color": "globals/colors?id=primary", "typography_typography": "globals/typography?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_element_id": "zone-titlu"}, "elements": []}, {"id": "zone00b", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Zece județe de Muntenie, patru de Oltenia, trei de Moldova, două de Dobrogea și unul de Ardeal. Ordinea de mai jos e a distanței, nu a regiunii: sub fiecare nume stau kilometrii rutieri din București și ce anume se cere muzical acolo — două informații care, împreună, spun aproape tot ce contează înainte de o discuție.</p>", "text_color": "#C6C6C6", "custom_css": "selector p{margin:0}", "__globals__": {"text_color": "globals/colors?id=secondary", "typography_typography": "globals/typography?id=text"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": []}], "isInner": true}, {"id": "zone00d", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><div class=\"grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 md:gap-gutter items-stretch\">\n<article class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Muntenia</span>\n<h3 class=\"font-headline-md text-xl md:text-headline-md leading-snug\">Ilfov</h3>\n<p class=\"font-body-md text-[13px] uppercase tracking-widest text-on-surface-variant\">~20–40 km din București</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Aceleași jocuri ca în Capitală — horă, sârbă și brâu în măsuri de doi timpi. La distanța asta nu se pune problema cazării, iar transportul nu se adaugă deloc: Ilfovul are aceleași prețuri ca Bucureștiul.</p>\n<p class=\"mt-auto pt-2\"><a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex items-center gap-2 min-h-[44px]\" href=\"/zone/ilfov/\">Vezi pagina zonei <svg aria-hidden=\"true\" class=\"text-[18px]\" fill=\"currentColor\" height=\"1em\" style=\"vertical-align:-.125em\" viewbox=\"0 -960 960 960\" width=\"1em\"><path d=\"M693.69-457.31H180v-45.38h513.69L448.39-748 480-780l300 300-300 300-31.61-32 245.3-245.31Z\"></path></svg></a></p>\n</article>\n<article class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Muntenia</span>\n<h3 class=\"font-headline-md text-xl md:text-headline-md leading-snug\">Prahova / Ploiești</h3>\n<p class=\"font-body-md text-[13px] uppercase tracking-widest text-on-surface-variant\">~60 km din București</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Muntenia de sub munte. Fond muntenesc, peste care s-au așezat piesele de Valea Prahovei intrate în repertoriul de petrecere. Fără cazare.</p>\n<p class=\"mt-auto pt-2\"><a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex items-center gap-2 min-h-[44px]\" href=\"/zone/prahova/\">Vezi pagina zonei <svg aria-hidden=\"true\" class=\"text-[18px]\" fill=\"currentColor\" height=\"1em\" style=\"vertical-align:-.125em\" viewbox=\"0 -960 960 960\" width=\"1em\"><path d=\"M693.69-457.31H180v-45.38h513.69L448.39-748 480-780l300 300-300 300-31.61-32 245.3-245.31Z\"></path></svg></a></p>\n</article>\n<article class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Muntenia</span>\n<h3 class=\"font-headline-md text-xl md:text-headline-md leading-snug\">Dâmbovița</h3>\n<p class=\"font-body-md text-[13px] uppercase tracking-widest text-on-surface-variant\">~50–80 km din București</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Zonă de deal, între câmpie și Muscel. Spre nordul județului repertoriul capătă accente de Argeș. Fără cazare.</p>\n<p class=\"mt-auto pt-2\"><a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex items-center gap-2 min-h-[44px]\" href=\"/zone/dambovita/\">Vezi pagina zonei <svg aria-hidden=\"true\" class=\"text-[18px]\" fill=\"currentColor\" height=\"1em\" style=\"vertical-align:-.125em\" viewbox=\"0 -960 960 960\" width=\"1em\"><path d=\"M693.69-457.31H180v-45.38h513.69L448.39-748 480-780l300 300-300 300-31.61-32 245.3-245.31Z\"></path></svg></a></p>\n</article>\n<article class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Muntenia</span>\n<h3 class=\"font-headline-md text-xl md:text-headline-md leading-snug\">Giurgiu</h3>\n<p class=\"font-body-md text-[13px] uppercase tracking-widest text-on-surface-variant\">~60–90 km din București</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Muntenie de câmpie, la Dunăre: repertoriu muntenesc curat, fără capitol regional separat. Fără cazare.</p>\n<p class=\"mt-auto pt-2\"><a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex items-center gap-2 min-h-[44px]\" href=\"/zone/giurgiu/\">Vezi pagina zonei <svg aria-hidden=\"true\" class=\"text-[18px]\" fill=\"currentColor\" height=\"1em\" style=\"vertical-align:-.125em\" viewbox=\"0 -960 960 960\" width=\"1em\"><path d=\"M693.69-457.31H180v-45.38h513.69L448.39-748 480-780l300 300-300 300-31.61-32 245.3-245.31Z\"></path></svg></a></p>\n</article>\n<article class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Muntenia</span>\n<h3 class=\"font-headline-md text-xl md:text-headline-md leading-snug\">Teleorman</h3>\n<p class=\"font-body-md text-[13px] uppercase tracking-widest text-on-surface-variant\">~90–110 km din București</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Câmpie dunăreană. Jocul rapid e în doi timpi, cu tempo iute și pas apăsat. Fără cazare.</p>\n<p class=\"mt-auto pt-2\"><a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex items-center gap-2 min-h-[44px]\" href=\"/zone/teleorman/\">Vezi pagina zonei <svg aria-hidden=\"true\" class=\"text-[18px]\" fill=\"currentColor\" height=\"1em\" style=\"vertical-align:-.125em\" viewbox=\"0 -960 960 960\" width=\"1em\"><path d=\"M693.69-457.31H180v-45.38h513.69L448.39-748 480-780l300 300-300 300-31.61-32 245.3-245.31Z\"></path></svg></a></p>\n</article>\n<article class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Muntenia</span>\n<h3 class=\"font-headline-md text-xl md:text-headline-md leading-snug\">Călărași</h3>\n<p class=\"font-body-md text-[13px] uppercase tracking-widest text-on-surface-variant\">~110 km din București</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Bărăgan și Dunăre. Horă și sârbă, într-un repertoriu apropiat de cel din Ialomița. Fără cazare.</p>\n<p class=\"mt-auto pt-2\"><a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex items-center gap-2 min-h-[44px]\" href=\"/zone/calarasi/\">Vezi pagina zonei <svg aria-hidden=\"true\" class=\"text-[18px]\" fill=\"currentColor\" height=\"1em\" style=\"vertical-align:-.125em\" viewbox=\"0 -960 960 960\" width=\"1em\"><path d=\"M693.69-457.31H180v-45.38h513.69L448.39-748 480-780l300 300-300 300-31.61-32 245.3-245.31Z\"></path></svg></a></p>\n</article>\n<article class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Muntenia</span>\n<h3 class=\"font-headline-md text-xl md:text-headline-md leading-snug\">Buzău</h3>\n<p class=\"font-body-md text-[13px] uppercase tracking-widest text-on-surface-variant\">~110 km din București</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Trecere dinspre Muntenia spre Moldova: repertoriul cerut le amestecă des pe amândouă. Pentru localitățile de munte, cazarea se discută.</p>\n<p class=\"mt-auto pt-2\"><a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex items-center gap-2 min-h-[44px]\" href=\"/zone/buzau/\">Vezi pagina zonei <svg aria-hidden=\"true\" class=\"text-[18px]\" fill=\"currentColor\" height=\"1em\" style=\"vertical-align:-.125em\" viewbox=\"0 -960 960 960\" width=\"1em\"><path d=\"M693.69-457.31H180v-45.38h513.69L448.39-748 480-780l300 300-300 300-31.61-32 245.3-245.31Z\"></path></svg></a></p>\n</article>\n<article class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Muntenia</span>\n<h3 class=\"font-headline-md text-xl md:text-headline-md leading-snug\">Ialomița</h3>\n<p class=\"font-body-md text-[13px] uppercase tracking-widest text-on-surface-variant\">~100–130 km din București</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Bărăgan. Fond muntenesc, cu localități spre est care ating pragul de la care cazarea intră în discuție.</p>\n<p class=\"mt-auto pt-2\"><a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex items-center gap-2 min-h-[44px]\" href=\"/zone/ialomita/\">Vezi pagina zonei <svg aria-hidden=\"true\" class=\"text-[18px]\" fill=\"currentColor\" height=\"1em\" style=\"vertical-align:-.125em\" viewbox=\"0 -960 960 960\" width=\"1em\"><path d=\"M693.69-457.31H180v-45.38h513.69L448.39-748 480-780l300 300-300 300-31.61-32 245.3-245.31Z\"></path></svg></a></p>\n</article>\n<article class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Muntenia</span>\n<h3 class=\"font-headline-md text-xl md:text-headline-md leading-snug\">Argeș / Pitești</h3>\n<p class=\"font-body-md text-[13px] uppercase tracking-widest text-on-surface-variant\">~120 km din București</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Muscel și Argeș — brâu și joc de Muscel peste fondul muntenesc. Cazarea depinde de localitate.</p>\n<p class=\"mt-auto pt-2\"><a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex items-center gap-2 min-h-[44px]\" href=\"/zone/arges/\">Vezi pagina zonei <svg aria-hidden=\"true\" class=\"text-[18px]\" fill=\"currentColor\" height=\"1em\" style=\"vertical-align:-.125em\" viewbox=\"0 -960 960 960\" width=\"1em\"><path d=\"M693.69-457.31H180v-45.38h513.69L448.39-748 480-780l300 300-300 300-31.61-32 245.3-245.31Z\"></path></svg></a></p>\n</article>\n<article class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Ardeal</span>\n<h3 class=\"font-headline-md text-xl md:text-headline-md leading-snug\">Brașov</h3>\n<p class=\"font-body-md text-[13px] uppercase tracking-widest text-on-surface-variant\">~170 km din București</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Învârtită, joc de doi și bărbunc, cu melodica pe vioară dublată de contră. Cazare obligatorie la eveniment de seară.</p>\n<p class=\"mt-auto pt-2\"><a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex items-center gap-2 min-h-[44px]\" href=\"/zone/brasov/\">Vezi pagina zonei <svg aria-hidden=\"true\" class=\"text-[18px]\" fill=\"currentColor\" height=\"1em\" style=\"vertical-align:-.125em\" viewbox=\"0 -960 960 960\" width=\"1em\"><path d=\"M693.69-457.31H180v-45.38h513.69L448.39-748 480-780l300 300-300 300-31.61-32 245.3-245.31Z\"></path></svg></a></p>\n</article>\n<article class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Oltenia</span>\n<h3 class=\"font-headline-md text-xl md:text-headline-md leading-snug\">Olt</h3>\n<p class=\"font-body-md text-[13px] uppercase tracking-widest text-on-surface-variant\">~165–180 km din București</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Cursul inferior al Oltului, de la Slatina până la Dunăre. Melodie de joc densă, cu multe note de trecere. Kilometrii se schimbă mult între capete.</p>\n<p class=\"mt-auto pt-2\"><a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex items-center gap-2 min-h-[44px]\" href=\"/zone/olt/\">Vezi pagina zonei <svg aria-hidden=\"true\" class=\"text-[18px]\" fill=\"currentColor\" height=\"1em\" style=\"vertical-align:-.125em\" viewbox=\"0 -960 960 960\" width=\"1em\"><path d=\"M693.69-457.31H180v-45.38h513.69L448.39-748 480-780l300 300-300 300-31.61-32 245.3-245.31Z\"></path></svg></a></p>\n</article>\n<article class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Oltenia</span>\n<h3 class=\"font-headline-md text-xl md:text-headline-md leading-snug\">Vâlcea</h3>\n<p class=\"font-body-md text-[13px] uppercase tracking-widest text-on-surface-variant\">~180 km din București</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Oltenie de sub munte, pe valea Oltului. Taraf cu țambal și repertoriu de căluș, separat de ritual. Cazarea, după localitate și oră.</p>\n<p class=\"mt-auto pt-2\"><a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex items-center gap-2 min-h-[44px]\" href=\"/zone/valcea/\">Vezi pagina zonei <svg aria-hidden=\"true\" class=\"text-[18px]\" fill=\"currentColor\" height=\"1em\" style=\"vertical-align:-.125em\" viewbox=\"0 -960 960 960\" width=\"1em\"><path d=\"M693.69-457.31H180v-45.38h513.69L448.39-748 480-780l300 300-300 300-31.61-32 245.3-245.31Z\"></path></svg></a></p>\n</article>\n<article class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Moldova</span>\n<h3 class=\"font-headline-md text-xl md:text-headline-md leading-snug\">Vrancea</h3>\n<p class=\"font-body-md text-[13px] uppercase tracking-widest text-on-surface-variant\">~190 km din București</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Județul-prag, cu Milcovul la sud. Locul prin care repertoriul moldovenesc ajunge în Muntenia. Trei trepte: câmpie, podgorie, munte.</p>\n<p class=\"mt-auto pt-2\"><a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex items-center gap-2 min-h-[44px]\" href=\"/zone/vrancea/\">Vezi pagina zonei <svg aria-hidden=\"true\" class=\"text-[18px]\" fill=\"currentColor\" height=\"1em\" style=\"vertical-align:-.125em\" viewbox=\"0 -960 960 960\" width=\"1em\"><path d=\"M693.69-457.31H180v-45.38h513.69L448.39-748 480-780l300 300-300 300-31.61-32 245.3-245.31Z\"></path></svg></a></p>\n</article>\n<article class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Muntenia</span>\n<h3 class=\"font-headline-md text-xl md:text-headline-md leading-snug\">Brăila</h3>\n<p class=\"font-body-md text-[13px] uppercase tracking-widest text-on-surface-variant\">~200 km din București</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Oraș-port cu Bărăganul în spate. Brâul, cu figurile comandate din capătul șirului. Distanțe interne mici, un singur centru.</p>\n<p class=\"mt-auto pt-2\"><a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex items-center gap-2 min-h-[44px]\" href=\"/zone/braila/\">Vezi pagina zonei <svg aria-hidden=\"true\" class=\"text-[18px]\" fill=\"currentColor\" height=\"1em\" style=\"vertical-align:-.125em\" viewbox=\"0 -960 960 960\" width=\"1em\"><path d=\"M693.69-457.31H180v-45.38h513.69L448.39-748 480-780l300 300-300 300-31.61-32 245.3-245.31Z\"></path></svg></a></p>\n</article>\n<article class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Moldova</span>\n<h3 class=\"font-headline-md text-xl md:text-headline-md leading-snug\">Galați</h3>\n<p class=\"font-body-md text-[13px] uppercase tracking-widest text-on-surface-variant\">~220 km din București</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Moldova de la Dunăre, cu Prutul la est. Bătuta și strigăturile care țin ritmul. Două centre, Galați și Tecuci, cu distanță reală între ele.</p>\n<p class=\"mt-auto pt-2\"><a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex items-center gap-2 min-h-[44px]\" href=\"/zone/galati/\">Vezi pagina zonei <svg aria-hidden=\"true\" class=\"text-[18px]\" fill=\"currentColor\" height=\"1em\" style=\"vertical-align:-.125em\" viewbox=\"0 -960 960 960\" width=\"1em\"><path d=\"M693.69-457.31H180v-45.38h513.69L448.39-748 480-780l300 300-300 300-31.61-32 245.3-245.31Z\"></path></svg></a></p>\n</article>\n<article class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Dobrogea</span>\n<h3 class=\"font-headline-md text-xl md:text-headline-md leading-snug\">Constanța</h3>\n<p class=\"font-body-md text-[13px] uppercase tracking-widest text-on-surface-variant\">~225 km din București</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Horă și sârbă, plus registre balcanice în măsuri asimetrice. Cazare obligatorie, rezervată odată cu data.</p>\n<p class=\"mt-auto pt-2\"><a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex items-center gap-2 min-h-[44px]\" href=\"/zone/constanta/\">Vezi pagina zonei <svg aria-hidden=\"true\" class=\"text-[18px]\" fill=\"currentColor\" height=\"1em\" style=\"vertical-align:-.125em\" viewbox=\"0 -960 960 960\" width=\"1em\"><path d=\"M693.69-457.31H180v-45.38h513.69L448.39-748 480-780l300 300-300 300-31.61-32 245.3-245.31Z\"></path></svg></a></p>\n</article>\n<article class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Oltenia</span>\n<h3 class=\"font-headline-md text-xl md:text-headline-md leading-snug\">Dolj / Craiova</h3>\n<p class=\"font-body-md text-[13px] uppercase tracking-widest text-on-surface-variant\">~230 km din București</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Repertoriu oltenesc, cu sârbe rapide și cântec de joc în tempo susținut. La distanța asta se aplică aceeași regulă de cazare ca pentru litoral.</p>\n<p class=\"mt-auto pt-2\"><a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex items-center gap-2 min-h-[44px]\" href=\"/zone/dolj/\">Vezi pagina zonei <svg aria-hidden=\"true\" class=\"text-[18px]\" fill=\"currentColor\" height=\"1em\" style=\"vertical-align:-.125em\" viewbox=\"0 -960 960 960\" width=\"1em\"><path d=\"M693.69-457.31H180v-45.38h513.69L448.39-748 480-780l300 300-300 300-31.61-32 245.3-245.31Z\"></path></svg></a></p>\n</article>\n<article class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Dobrogea</span>\n<h3 class=\"font-headline-md text-xl md:text-headline-md leading-snug\">Tulcea</h3>\n<p class=\"font-body-md text-[13px] uppercase tracking-widest text-on-surface-variant\">~280 km din București</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Dobrogea de nord, cu Delta în spate. Geamparale și măsuri asimetrice peste fondul de câmpie. Pentru locațiile fără acces rutier, drumul are și o etapă pe apă.</p>\n<p class=\"mt-auto pt-2\"><a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex items-center gap-2 min-h-[44px]\" href=\"/zone/tulcea/\">Vezi pagina zonei <svg aria-hidden=\"true\" class=\"text-[18px]\" fill=\"currentColor\" height=\"1em\" style=\"vertical-align:-.125em\" viewbox=\"0 -960 960 960\" width=\"1em\"><path d=\"M693.69-457.31H180v-45.38h513.69L448.39-748 480-780l300 300-300 300-31.61-32 245.3-245.31Z\"></path></svg></a></p>\n</article>\n<article class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Moldova</span>\n<h3 class=\"font-headline-md text-xl md:text-headline-md leading-snug\">Bacău</h3>\n<p class=\"font-body-md text-[13px] uppercase tracking-widest text-on-surface-variant\">~295 km din București</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Moldova de sub munte, la confluența Siretului cu Trotușul. Horă moldovenească, iar în nord fanfare de alămuri. Cu cazare.</p>\n<p class=\"mt-auto pt-2\"><a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex items-center gap-2 min-h-[44px]\" href=\"/zone/bacau/\">Vezi pagina zonei <svg aria-hidden=\"true\" class=\"text-[18px]\" fill=\"currentColor\" height=\"1em\" style=\"vertical-align:-.125em\" viewbox=\"0 -960 960 960\" width=\"1em\"><path d=\"M693.69-457.31H180v-45.38h513.69L448.39-748 480-780l300 300-300 300-31.61-32 245.3-245.31Z\"></path></svg></a></p>\n</article>\n<article class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Oltenia</span>\n<h3 class=\"font-headline-md text-xl md:text-headline-md leading-snug\">Mehedinți</h3>\n<p class=\"font-body-md text-[13px] uppercase tracking-widest text-on-surface-variant\">~340 km din București</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Capătul de sud-vest, unde Dunărea intră în defileu. Sârbe și brâulețe cu figuri de virtuozitate. Cazare, la orice program.</p>\n<p class=\"mt-auto pt-2\"><a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex items-center gap-2 min-h-[44px]\" href=\"/zone/mehedinti/\">Vezi pagina zonei <svg aria-hidden=\"true\" class=\"text-[18px]\" fill=\"currentColor\" height=\"1em\" style=\"vertical-align:-.125em\" viewbox=\"0 -960 960 960\" width=\"1em\"><path d=\"M693.69-457.31H180v-45.38h513.69L448.39-748 480-780l300 300-300 300-31.61-32 245.3-245.31Z\"></path></svg></a></p>\n</article>\n\n<p class=\"font-body-md text-body-md text-on-surface-variant mt-10 md:mt-12 max-w-3xl\">Județul spune ce jocuri se cer, dar forma serii o dă ocazia. Cum arată ea la o <a class=\"text-primary underline underline-offset-4 hover:text-white transition-colors\" href=\"/nunta/\">nuntă</a>, la un <a class=\"text-primary underline underline-offset-4 hover:text-white transition-colors\" href=\"/botez/\">botez</a>, la o <a class=\"text-primary underline underline-offset-4 hover:text-white transition-colors\" href=\"/eveniment-privat/\">petrecere de familie</a> sau la un <a class=\"text-primary underline underline-offset-4 hover:text-white transition-colors\" href=\"/corporate/\">eveniment de firmă</a> e explicat pe pagini separate. Ce se cântă în fiecare regiune e pe pagina de <a class=\"text-primary underline underline-offset-4 hover:text-white transition-colors\" href=\"/repertoriu/\">repertoriu</a>, iar cine urcă pe scenă, pe cea despre <a class=\"text-primary underline underline-offset-4 hover:text-white transition-colors\" href=\"/formatia/\">componența formației</a>.</p>\n</div></div>"}, "elements": []}], "isInner": false}, {"id": "zone010", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "0", "right": "24", "bottom": "0", "left": "24", "isLinked": false}}, "elements": [{"id": "zone00f", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"zona-divider\"></div>"}, "elements": []}], "isInner": false}, {"id": "zone012", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}}, "elements": [{"id": "zone011", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><div class=\"max-w-3xl\">\n<span class=\"font-label-md text-label-md text-primary uppercase tracking-[0.2em] block mb-4\">Mecanism</span>\n<h2 class=\"font-headline-lg text-2xl md:text-headline-lg leading-tight mb-6\" id=\"deplasare-titlu\">Cum ajunge distanța în preț</h2>\n<p class=\"font-body-lg text-base md:text-body-lg text-on-surface-variant\">Există exact două moduri prin care județul modifică oferta, și amândouă sunt previzibile dinainte. Primul e kilometrajul: se contorizează traseul dus-întors dintre București și locație, la un tarif unitar de 6 lei/km, pentru orice județ din afara Bucureștiului și a Ilfovului. Drumurile dintre localitățile enumerate pe pagina fiecărui județ nu se adaugă la el, oricare dintre ele ar fi locația.</p>\n<p class=\"font-body-lg text-base md:text-body-lg text-on-surface-variant mt-6\">Al doilea e cazarea, și ea se activează doar peste un prag de distanță, combinat cu ora la care se termină petrecerea. Criteriul e simplu: dacă echipa apucă să demonteze și să ajungă înapoi până dimineață, pe deviz nu apare nicio cameră; dacă nu apucă, se rezervă odată cu data, nu ulterior. Pentru județele din partea de sus a listei de mai sus a doua variabilă nu se activează niciodată — de aceea ele sunt și cele mai ieftine la aceeași configurație de pachet.</p>\n<p class=\"mt-8\"><a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex items-center gap-2 min-h-[44px]\" href=\"/oferte/\">Vezi pachetele și prețurile <svg aria-hidden=\"true\" class=\"text-[18px]\" fill=\"currentColor\" height=\"1em\" style=\"vertical-align:-.125em\" viewbox=\"0 -960 960 960\" width=\"1em\"><path d=\"M693.69-457.31H180v-45.38h513.69L448.39-748 480-780l300 300-300 300-31.61-32 245.3-245.31Z\"></path></svg></a></p>\n</div></div>"}, "elements": []}], "isInner": false}, {"id": "zone016", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 544, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#1C1B1B", "__globals__": {"background_color": "globals/colors?id=surfacealt"}, "custom_css": "selector{background-color:#1C1B1B}selector{border-top:1px solid rgba(68,71,72,.1)}selector{text-align:center}", "padding": {"unit": "px", "top": "96", "right": "64", "bottom": "96", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "96", "right": "64", "bottom": "96", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "64", "right": "24", "bottom": "64", "left": "24", "isLinked": false}}, "elements": [{"id": "zone013", "elType": "widget", "widgetType": "heading", "settings": {"title": "Nu vedeți județul în listă?", "header_size": "h2", "title_color": "#E5E2E1", "__globals__": {"title_color": "globals/colors?id=primary", "typography_typography": "globals/typography?id=primary"}, "align": "center", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "20", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "20", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "20", "left": "0", "isLinked": false}}, "elements": []}, {"id": "zone014", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Cele douăzeci de mai sus sunt cele cerute cel mai des, nu o graniță. Spuneți-ne localitatea și data: dacă distanța permite, calculul se face la fel ca pentru oricare dintre ele.</p>", "text_color": "#C6C6C6", "custom_css": "selector p{margin:0}", "__globals__": {"text_color": "globals/colors?id=secondary", "