"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "width": {"unit": "px", "size": 768, "sizes": []}, "width_mobile": {"unit": "%", "size": 100, "sizes": []}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "48", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "48", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "32", "left": "0", "isLinked": false}, "custom_css": "selector{max-width:100%}"}, "elements": [{"id": "zbra00f", "elType": "widget", "widgetType": "heading", "settings": {"title": "Acoperire", "header_size": "div", "title_color": "#C6C6C6", "typography_typography": "custom", "typography_font_family": "Inter", "typography_font_size": {"unit": "px", "size": 14, "sizes": []}, "typography_font_weight": "600", "typography_text_transform": "uppercase", "typography_letter_spacing": {"unit": "em", "size": 0.2, "sizes": []}, "typography_line_height": {"unit": "px", "size": 20, "sizes": []}, "__globals__": {"title_color": "globals/colors?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}}, "elements": []}, {"id": "zbra010", "elType": "widget", "widgetType": "heading", "settings": {"title": "Nouă localități în jurul portului", "header_size": "h2", "title_color": "#E5E2E1", "__globals__": {"title_color": "globals/colors?id=primary", "typography_typography": "globals/typography?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_element_id": "localitati-titlu"}, "elements": []}, {"id": "zbra011", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Municipiul adună cea mai mare parte a evenimentelor. Ianca, Făurei și Însurăței sunt orașele mici din interiorul câmpiei, iar Movila Miresii, Viziru, Tichilești, Chiscani și Gropeni completează inelul de comune din jurul Brăilei și de pe malul Dunării.</p>", "text_color": "#C6C6C6", "custom_css": "selector p{margin:0}", "__globals__": {"text_color": "globals/colors?id=secondary", "typography_typography": "globals/typography?id=quote"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": []}], "isInner": true}, {"id": "zbra013", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><div class=\"glass-card silver-border p-6 md:p-10 max-w-4xl\">\n<ul class=\"motif-list grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-4\">\n<li class=\"font-body-lg text-base md:text-body-lg\">Brăila</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Ianca</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Însurăței</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Făurei</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Movila Miresii</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Viziru</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Chiscani</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Gropeni</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Tichilești</li>\n</ul>\n<div class=\"motif-rule max-w-[180px] w-full mt-8\"><span class=\"motif-rule__gem zona-gem\"></span></div>\n<p class=\"font-body-md text-body-md text-on-surface-variant mt-6\">Pentru o comună care nu apare aici, distanța se calculează de la oraș în afară — județul e compact, iar drumurile pornesc radial din Brăila.</p>\n</div></div>"}, "elements": []}, {"id": "zbra014", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Peste Dunăre, spre est, malul celălalt e deja <a href=\"/zone/tulcea/\">Tulcea</a>, la care se trece cu bacul de la Smârdan. Spre nord, pe DN22, drumul intră în <a href=\"/zone/galati/\">Galați</a> după câteva zeci de minute, iar spre vest câmpia se continuă fără hotar vizibil în <a href=\"/zone/buzau/\">Buzău</a> și în <a href=\"/zone/ialomita/\">Ialomița</a>.</p>", "text_color": "#C6C6C6", "custom_css": "selector p{margin:0}selector{max-width:768px !important}", "__globals__": {"text_color": "globals/colors?id=secondary", "typography_typography": "globals/typography?id=text"}, "_margin": {"unit": "px", "top": "32", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "32", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "32", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": []}, {"id": "zbra015", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><p class=\"mt-8\"><a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex flex-wrap items-center gap-2 min-h-[44px]\" href=\"/zone/\">Toate zonele deservite</a></p></div>"}, "elements": []}], "isInner": false}, {"id": "zbra018", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "0", "right": "24", "bottom": "0", "left": "24", "isLinked": false}}, "elements": [{"id": "zbra017", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"zona-divider\"></div>"}, "elements": []}], "isInner": false}, {"id": "zbra01a", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}}, "elements": [{"id": "zbra019", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><div class=\"max-w-3xl\">\n<span class=\"font-label-md text-label-md text-primary uppercase tracking-[0.2em] block mb-4\">Repertoriu</span>\n<h2 class=\"font-headline-lg text-2xl md:text-headline-lg leading-tight mb-6\" id=\"repertoriu-titlu\">Brâul, și omul din capătul șirului</h2>\n<p class=\"font-body-lg text-base md:text-body-lg text-on-surface-variant\">Jocul muntenesc e un joc de grup: în cerc sau în șir, cu mâinile prinse ori cu brațele pe umerii vecinilor, pe o măsură binară care pune pasul pe fiecare bătaie. Figurile sunt puține și revin des, așa că cineva care n-a mai jucat niciodată prinde ritmul uitându-se la vecin, după câteva măsuri. Hora și sârba se deosebesc mai ales prin tempo — una așezată și cu cercul larg, cealaltă iute, cu pași mărunți și mișcare laterală.</p>\n<h3 class=\"font-headline-md text-lg md:text-headline-md text-on-surface leading-snug mt-9 mb-4\">Unde se schimbă lucrurile</h3>\n<p class=\"font-body-lg text-base md:text-body-lg text-on-surface-variant\">Brâul e altceva. Aici apar figurile: talpa bate, direcția se schimbă, iar semnalul îl dă omul din fruntea șirului — de regulă strigând. Asta înseamnă că nu formația conduce momentul, ci un om din sală, iar noi îl urmăm. Practic, e singura parte din seară în care tempoul se negociază pe loc, și de aceea ne interesează dinainte dacă în familie există cineva care duce brâul. <span class=\"ph\">[angajament de confirmat de client — B78]</span> În rest, o seară de câmpie stă pe jocuri: tempo ridicat, pas apăsat, iar momentele de ascultare rămân scurte.</p>\n\n<p class=\"mt-8\"><a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex flex-wrap items-center gap-2 min-h-[44px]\" href=\"/repertoriu/\">Vezi repertoriul complet</a></p>\n</div></div>"}, "elements": []}], "isInner": false}, {"id": "zbra01c", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "0", "right": "24", "bottom": "0", "left": "24", "isLinked": false}}, "elements": [{"id": "zbra01b", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"zona-divider\"></div>"}, "elements": []}], "isInner": false}, {"id": "zbra022", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}}, "elements": [{"id": "zbra020", "elType": "container", "settings": {"container_type": "flex", "content_width": "full", "flex_direction": "column", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "width": {"unit": "px", "size": 768, "sizes": []}, "width_mobile": {"unit": "%", "size": 100, "sizes": []}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "48", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "48", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "32", "left": "0", "isLinked": false}, "custom_css": "selector{max-width:100%}"}, "elements": [{"id": "zbra01d", "elType": "widget", "widgetType": "heading", "settings": {"title": "Logistică", "header_size": "div", "title_color": "#C6C6C6", "typography_typography": "custom", "typography_font_family": "Inter", "typography_font_size": {"unit": "px", "size": 14, "sizes": []}, "typography_font_weight": "600", "typography_text_transform": "uppercase", "typography_letter_spacing": {"unit": "em", "size": 0.2, "sizes": []}, "typography_line_height": {"unit": "px", "size": 20, "sizes": []}, "__globals__": {"title_color": "globals/colors?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}}, "elements": []}, {"id": "zbra01e", "elType": "widget", "widgetType": "heading", "settings": {"title": "Un județ compact, cu o singură direcție lungă", "header_size": "h2", "title_color": "#E5E2E1", "__globals__": {"title_color": "globals/colors?id=primary", "typography_typography": "globals/typography?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_element_id": "logistica-titlu"}, "elements": []}, {"id": "zbra01f", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Drumul de la București se face pe A2 și apoi pe DN2B, fără porțiuni dificile. Odată ajunși în județ, distanțele interne sunt mici. Se aplică tariful obișnuit, 6 lei/km pe traseul dus-întors.</p>", "text_color": "#C6C6C6", "custom_css": "selector p{margin:0}", "__globals__": {"text_color": "globals/colors?id=secondary", "typography_typography": "globals/typography?id=text"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": []}], "isInner": true}, {"id": "zbra021", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><div class=\"grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-gutter max-w-4xl\">\n<div class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Distanță</span>\n<p class=\"font-display-lg text-3xl md:text-4xl text-on-surface\">~200 km din București</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Lipsește deocamdată cifra; o luăm din măsurătoarea unitară, nu de pe hartă. Ce se poate spune de pe acum e că Brăila e capătul estic al câmpiei pe care o acoperim, iar timpul de drum e dominat de porțiunea de autostradă.</p>\n</div>\n<div class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Deplasare</span>\n<p class=\"font-headline-md text-xl md:text-headline-md text-on-surface\">Echipamentul intră în oraș înaintea orelor de vârf</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Schela, luminile și sonorizarea fac prima cursă, cu oamenii care le montează; solista și instrumentiștii pornesc separat, când scena e deja pregătită. Când locația e în municipiu, ora de intrare se alege ca să nu prindă traficul de sâmbătă.</p>\n</div>\n<div class=\"glass-card silver-border p-6 md:p-8 md:col-span-2 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Cazare</span>\n<p class=\"font-headline-md text-xl md:text-headline-md text-on-surface\">Se hotărăște după ora de final</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Pentru un program care se încheie devreme, drumul înapoi se face în aceeași noapte. Pentru unul lung, se discută camerele. <span class=\"ph\">[CAZARE BRĂILA — de confirmat]</span></p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Regula nu ține de localitate, ci de ceas: în Brăila, toate localitățile din listă sunt la fel de aproape de oraș.</p>\n</div>\n</div></div>"}, "elements": []}], "isInner": false}, {"id": "zbra024", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "0", "right": "24", "bottom": "0", "left": "24", "isLinked": false}}, "elements": [{"id": "zbra023", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"zona-divider\"></div>"}, "elements": []}], "isInner": false}, {"id": "zbra026", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}}, "elements": [{"id": "zbra025", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><div class=\"max-w-3xl mx-auto glass-card silver-border p-6 md:p-12 text-center flex flex-col items-center gap-5\">\n<span class=\"font-label-md text-label-md text-primary uppercase tracking-[0.2em]\">Pachete</span>\n<h2 class=\"font-headline-lg text-2xl md:text-headline-lg leading-tight\" id=\"pachete-titlu\">Un singur rând peste pachet, de cele mai multe ori</h2>\n<p class=\"font-body-lg text-base md:text-body-lg text-on-surface-variant\">Configurațiile sunt cele din grila generală. Pentru Brăila, în majoritatea cazurilor oferta finală are pachetul plus o linie de transport, fără nimic altceva.</p>\n\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Prima întrebare nu e unde, ci ce sărbătoriți: o <a class=\"text-primary underline underline-offset-4 hover:text-white transition-colors\" href=\"/nunta/\">nuntă</a> sau un <a class=\"text-primary underline underline-offset-4 hover:text-white transition-colors\" href=\"/botez/\">botez</a>. Apoi vin celelalte două formate, <a class=\"text-primary underline underline-offset-4 hover:text-white transition-colors\" href=\"/eveniment-privat/\">petrecerea în familie</a> și <a class=\"text-primary underline underline-offset-4 hover:text-white transition-colors\" href=\"/corporate/\">seara de firmă</a>, fiecare cu alt tipar de seară.</p>\n<div class=\"motif-rule max-w-[180px] w-full\"><span class=\"motif-rule__gem zona-gem\"></span></div>\n<div class=\"flex flex-col sm:flex-row gap-4 w-full sm:w-auto\">\n<a class=\"inline-block text-center whitespace-nowrap bg-accent text-white px-8 md:px-10 py-4 uppercase font-label-md text-label-md tracking-widest hover:bg-accent-hover transition-colors w-full sm:w-auto\" href=\"/oferte/\">Vezi toate pachetele</a>\n<a class=\"btn-secundar-zona inline-block text-center whitespace-nowrap text-on-surface bg-transparent px-8 md:px-10 py-4 uppercase font-label-md text-label-md tracking-widest hover:bg-white/5 transition-colors w-full sm:w-auto\" href=\"/contact/\">Cere ofertă</a>\n</div>\n</div></div>"}, "elements": []}], "isInner": false}, {"id": "zbra028", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "0", "right": "24", "bottom": "0", "left": "24", "isLinked": false}}, "elements": [{"id": "zbra027", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"zona-divider\"></div>"}, "elements": []}], "isInner": false}, {"id": "zbra033", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}}, "elements": [{"id": "zbra02b", "elType": "container", "settings": {"container_type": "flex", "content_width": "full", "flex_direction": "column", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "width": {"unit": "px", "size": 768, "sizes": []}, "width_mobile": {"unit": "%", "size": 100, "sizes": []}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "48", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "48", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "32", "left": "0", "isLinked": false}, "custom_css": "selector{max-width:100%}"}, "elements": [{"id": "zbra029", "elType": "widget", "widgetType": "heading", "settings": {"title": "Întrebări", "header_size": "div", "title_color": "#C6C6C6", "typography_typography": "custom", "typography_font_family": "Inter", "typography_font_size": {"unit": "px", "size": 14, "sizes": []}, "typography_font_weight": "600", "typography_text_transform": "uppercase", "typography_letter_spacing": {"unit": "em", "size": 0.2, "sizes": []}, "typography_line_height": {"unit": "px", "size": 20, "sizes": []}, "__globals__": {"title_color": "globals/colors?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}}, "elements": []}, {"id": "zbra02a", "elType": "widget", "widgetType": "heading", "settings": {"title": "Brâul, portul și câmpia", "header_size": "h2", "title_color": "#E5E2E1", "__globals__": {"title_color": "globals/colors?id=primary", "typography_typography": "globals/typography?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "_element_id": "faq-titlu"}, "elements": []}], "isInner": true}, {"id": "zbra031", "elType": "container", "settings": {"container_type": "flex", "content_width": "full", "flex_direction": "column", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "width": {"unit": "px", "size": 768, "sizes": []}, "width_mobile": {"unit": "%", "size": 100, "sizes": []}, "custom_css": "selector{max-width:100%}", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": [{"id": "zbra02c", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"faq-item\"><details open><summary aria-expanded=\"true\"><h3>În familie avem pe cineva care „duce brâul”. Vă potriviți cu el?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 -960 960 960\" fill=\"currentColor\"><path d=\"M480-357.85 253.85-584l32.61-32.61L480-423.08l193.54-193.53L706.15-584 480-357.85Z\"/></svg></summary><div class=\"faq-item__answer\"><p>Da, și e chiar de preferat. Brâul e jocul în care comanda vine din capătul șirului, prin strigături, iar formația merge după el.</p>\n<p>Ne spuneți dinainte, ca să lăsăm momentul mai larg în program și să nu-l tăiem din grabă.</p></div></details></div>", "custom_css": "selector{margin-bottom:16px}selector h3{margin:0;padding-right:16px;font-family:\"EB Garamond\",Georgia,serif;font-size:16px;font-weight:500;line-height:1.375;color:var(--e-global-color-primary)}@media(min-width:768px){selector h3{font-size:24px}}selector .faq-item__answer{font-family:Inter,sans-serif;font-size:16px;line-height:1.6}selector .faq-item__answer p{margin:0}selector .faq-item__answer p+p{margin-top:12px}"}, "elements": []}, {"id": "zbra02d", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"faq-item\"><details><summary aria-expanded=\"false\"><h3>Sala e în Insula Mare a Brăilei. Se ajunge cu echipamentul?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 -960 960 960\" fill=\"currentColor\"><path d=\"M480-357.85 253.85-584l32.61-32.61L480-423.08l193.54-193.53L706.15-584 480-357.85Z\"/></svg></summary><div class=\"faq-item__answer\"><p>Ne spuneți adresa exactă și verificăm traseul înainte de a confirma ora. Ce contează e pe unde se face trecerea și dacă e disponibilă în ziua respectivă.</p>\n<p>Kilometrajul se calculează pe drumul real, nu pe distanța în linie dreaptă.</p></div></details></div>", "custom_css": "selector{margin-bottom:16px}selector h3{margin:0;padding-right:16px;font-family:\"EB Garamond\",Georgia,serif;font-size:16px;font-weight:500;line-height:1.375;color:var(--e-global-color-primary)}@media(min-width:768px){selector h3{font-size:24px}}selector .faq-item__answer{font-family:Inter,sans-serif;font-size:16px;line-height:1.6}selector .faq-item__answer p{margin:0}selector .faq-item__answer p+p{margin-top:12px}"}, "elements": []}, {"id": "zbra02e", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"faq-item\"><details><summary aria-expanded=\"false\"><h3>Nunta e sâmbătă seara, în centru. Ajungeți la timp cu montajul?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 -960 960 960\" fill=\"currentColor\"><path d=\"M480-357.85 253.85-584l32.61-32.61L480-423.08l193.54-193.53L706.15-584 480-357.85Z\"/></svg></summary><div class=\"faq-item__answer\"><p>Da, dar echipa tehnică pleacă devreme tocmai pentru asta. Montajul se face înainte de ora la care traficul din oraș devine o problemă.</p>\n<p>Ce ne ajută e să știm dacă există loc de descărcare aproape de intrare sau dacă echipamentul se cară pe o distanță mai mare.</p></div></details></div>", "custom_css": "selector{margin-bottom:16px}selector h3{margin:0;padding-right:16px;font-family:\"EB Garamond\",Georgia,serif;font-size:16px;font-weight:500;line-height:1.375;color:var(--e-global-color-primary)}@media(min-width:768px){selector h3{font-size:24px}}selector .faq-item__answer{font-family:Inter,sans-serif;font-size:16px;line-height:1.6}selector .faq-item__answer p{margin:0}selector .faq-item__answer p+p{margin-top:12px}"}, "elements": []}, {"id": "zbra02f", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"faq-item\"><details><summary aria-expanded=\"false\"><h3>Jumătate din invitați vin din Galați. Contează pentru program?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 -960 960 960\" fill=\"currentColor\"><path d=\"M480-357.85 253.85-584l32.61-32.61L480-423.08l193.54-193.53L706.15-584 480-357.85Z\"/></svg></summary><div class=\"faq-item__answer\"><p>Contează lista de invitați, indiferent din ce județ vin. Dacă un grup mare are alte jocuri în comun, blocul respectiv capătă mai mult spațiu.</p>\n<p>Proporțiile se stabilesc la discuția de organizare, după ce ne spuneți de unde sunt familiile.</p></div></details></div>", "custom_css": "selector{margin-bottom:16px}selector h3{margin:0;padding-right:16px;font-family:\"EB Garamond\",Georgia,serif;font-size:16px;font-weight:500;line-height:1.375;color:var(--e-global-color-primary)}@media(min-width:768px){selector h3{font-size:24px}}selector .faq-item__answer{font-family:Inter,sans-serif;font-size:16px;line-height:1.6}selector .faq-item__answer p{margin:0}selector .faq-item__answer p+p{margin-top:12px}"}, "elements": []}, {"id": "zbra030", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"faq-item\"><details><summary aria-expanded=\"false\"><h3>Facem petrecerea vara, în curte, la o comună din câmpie. E vreo problemă?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 -960 960 960\" fill=\"currentColor\"><path d=\"M480-357.85 253.85-584l32.61-32.61L480-423.08l193.54-193.53L706.15-584 480-357.85Z\"/></svg></summary><div class=\"faq-item__answer\"><p>Nu, dar se pregătește altfel decât o sală. Ne interesează sursa de curent, suprafața pe care se montează scena și dacă există o variantă acoperită în caz de ploaie.</p>\n<p>Pentru câmpie deschisă, vântul de seară contează mai mult decât temperatura.</p></div></details></div>", "custom_css": "selector{margin-bottom:16px}selector h3{margin:0;padding-right:16px;font-family:\"EB Garamond\",Georgia,serif;font-size:16px;font-weight:500;line-height:1.375;color:var(--e-global-color-primary)}@media(min-width:768px){selector h3{font-size:24px}}selector .faq-item__answer{font-family:Inter,sans-serif;font-size:16px;line-height:1.6}selector .faq-item__answer p{margin:0}selector .faq-item__answer p+p{margin-top:12px}"}, "elements": []}], "isInner": true}, {"id": "zbra032", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><div class=\"mt-10 md:mt-12\">\n<a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex items-center gap-2 min-h-[44px]\" href=\"/faq/\">Vezi toate întrebările frecvente <svg aria-hidden=\"true\" class=\"text-[18px]\" fill=\"currentColor\" height=\"1em\" style=\"vertical-align:-.125em\" viewbox=\"0 -960 960 960\" width=\"1em\"><path d=\"M693.69-457.31H180v-45.38h513.69L448.39-748 480-780l300 300-300 300-31.61-32 245.3-245.31Z\"></path></svg></a>\n</div></div>"}, "elements": []}], "isInner": false}, {"id": "zbra037", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 544, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#1C1B1B", "__globals__": {"background_color": "globals/colors?id=surfacealt"}, "custom_css": "selector{background-color:#1C1B1B}selector{border-top:1px solid rgba(68,71,72,.1)}selector{text-align:center}", "padding": {"unit": "px", "top": "96", "right": "64", "bottom": "96", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "96", "right": "64", "bottom": "96", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "64", "right": 