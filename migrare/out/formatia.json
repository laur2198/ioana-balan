": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}}, "elements": [{"id": "form00d", "elType": "container", "settings": {"container_type": "flex", "content_width": "full", "flex_direction": "column", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "width": {"unit": "px", "size": 768, "sizes": []}, "width_mobile": {"unit": "%", "size": 100, "sizes": []}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "48", "left": "0", "isLinked": false}, "margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "48", "left": "0", "isLinked": false}, "margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "32", "left": "0", "isLinked": false}, "custom_css": "selector{max-width:100%}"}, "elements": [{"id": "form009", "elType": "widget", "widgetType": "heading", "settings": {"title": "Componență", "header_size": "div", "title_color": "#C6C6C6", "typography_typography": "custom", "typography_font_family": "Inter", "typography_font_size": {"unit": "px", "size": 14, "sizes": []}, "typography_font_weight": "600", "typography_text_transform": "uppercase", "typography_letter_spacing": {"unit": "em", "size": 0.2, "sizes": []}, "typography_line_height": {"unit": "px", "size": 20, "sizes": []}, "__globals__": {"title_color": "globals/colors?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}}, "elements": []}, {"id": "form00a", "elType": "widget", "widgetType": "heading", "settings": {"title": "Roluri pe scenă", "header_size": "h2", "title_color": "#E5E2E1", "__globals__": {"title_color": "globals/colors?id=primary", "typography_typography": "globals/typography?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_element_id": "componenta-titlu"}, "elements": []}, {"id": "form00b", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Numărul de oameni pe scenă diferă de la o configurație la alta; rolurile rămân aceleași. Mai jos sunt grupate după ce face fiecare în timpul serii.</p>", "text_color": "#C6C6C6", "custom_css": "selector p{margin:0}", "__globals__": {"text_color": "globals/colors?id=secondary", "typography_typography": "globals/typography?id=text"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": []}, {"id": "form00c", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><span class=\"ph\">[NUME INSTRUMENTIȘTI — de confirmat dacă se publică]</span></p>", "text_color": "#C6C6C6", "custom_css": "selector p{margin:0}", "__globals__": {"text_color": "globals/colors?id=secondary", "typography_typography": "globals/typography?id=text"}, "_margin": {"unit": "px", "top": "16", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "16", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "16", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": []}], "isInner": true}, {"id": "form00e", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><div class=\"grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-gutter max-w-5xl\">\n<article class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Melodie</span>\n<h3 class=\"font-headline-md text-xl md:text-headline-md leading-snug\">Instrumente melodice</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Vioara, saxofonul și acordeonul poartă linia melodică. Vioara conduce în jocurile populare și în cântecele lente, unde frazarea ei e cea mai apropiată de voce. Saxofonul o dublează sau îi răspunde în folclor și trece în prim-plan în muzica de petrecere și în cea balcanică. Acordeonul lucrează pe două planuri: umple armonia sub vioară și preia melodia în horele și sârbele iuți, unde articulația lui scurtă se aude cel mai bine.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">În configurația extinsă se poate adăuga țambalul, instrumentul cu coarde lovite cu ciocănele care dă sunetul lăutăresc clasic.</p>\n</article>\n<article class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Puls</span>\n<h3 class=\"font-headline-md text-xl md:text-headline-md leading-snug\">Ritm și armonie</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">În configurațiile mici, clapa ține singură fundația: basul, acordurile și pulsul pe care se sprijină restul formației. În configurația extinsă de nuntă, ritmul trece la doi oameni, percuționistul și toboșarul, iar clapa rămâne pe armonie.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Diferența se aude mai ales spre final. Un puls cântat live urmează dinamica sălii — intensitate, accente, opriri pe final de frază —, pe când unul generat de clapă rămâne identic de la prima la ultima măsură.</p>\n</article>\n<article class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Voci</span>\n<h3 class=\"font-headline-md text-xl md:text-headline-md leading-snug\">Interpreți</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Ioana Balan cântă muzica populară și pe cea de petrecere. La nuntă, muzica ușoară, românească și internațională, are un interpret separat, astfel încât fiecare registru să aibă vocea lui. În configurația extinsă se poate adăuga un al treilea interpret, pentru repertoriul balcanic. La botez, o singură voce acoperă atât populara, cât și ușoara.</p>\n<p class=\"mt-auto pt-2\"><a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex items-center gap-2 min-h-[44px]\" href=\"/repertoriu/\">Ce se cântă, pe zone <svg aria-hidden=\"true\" class=\"text-[18px]\" fill=\"currentColor\" height=\"1em\" style=\"vertical-align:-.125em\" viewbox=\"0 -960 960 960\" width=\"1em\"><path d=\"M693.69-457.31H180v-45.38h513.69L448.39-748 480-780l300 300-300 300-31.61-32 245.3-245.31Z\"></path></svg></a></p>\n</article>\n<article class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Desfășurare</span>\n<h3 class=\"font-headline-md text-xl md:text-headline-md leading-snug\">DJ și MC</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">DJ-ul acoperă pauzele dintre programele live și preia petrecerea spre final, cu repertoriul pe care formația nu îl cântă. MC-ul ține firul serii: anunță intrarea mirilor, tortul și celelalte momente și le coordonează cu sala și cu fotograful, ca desfășurarea să nu depindă de cine se nimerește lângă microfon.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">La nuntă ambele roluri sunt prezente toată seara. Pachetele de botez includ DJ, fără MC.</p>\n</article>\n\n\n<article class=\"glass-card silver-border p-6 md:p-8 md:col-span-2 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Moment de program</span>\n<h3 class=\"font-headline-md text-xl md:text-headline-md leading-snug\">Interpret manele <span class=\"text-on-surface-variant\">(opțional)</span></h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Un interpret din formație poate prelua manelele din blocul de petrecere, ca registrul acesta să aibă vocea lui, separată de a solistei. Nu face parte din niciuna dintre configurațiile de mai jos.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Are cost suplimentar, separat de pachet. Dacă îl vreți și cât din seară cântă, se hotărăște la discuția de organizare.</p>\n<p class=\"mt-auto pt-2\"><a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex items-center gap-2 min-h-[44px]\" href=\"/folclor-si-manele/#interpret-manele-titlu\">Unde stă în program <svg aria-hidden=\"true\" class=\"text-[18px]\" fill=\"currentColor\" height=\"1em\" style=\"vertical-align:-.125em\" viewbox=\"0 -960 960 960\" width=\"1em\"><path d=\"M693.69-457.31H180v-45.38h513.69L448.39-748 480-780l300 300-300 300-31.61-32 245.3-245.31Z\"></path></svg></a></p>\n</article>\n</div></div>"}, "elements": []}], "isInner": false}, {"id": "form011", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top":