{"meta": {"src": "formatia.html", "slug": "formatia", "parent": null, "noindex": false, "seo_title": "Formația: Instrumente, Interpreți și Producție Tehnică | Ioana Balan", "metadesc": "Componența formației Ioanei Balan pe roluri — instrumente, interpreți, DJ și MC —, configurațiile de la botez la pachetul extins și producția tehnică.", "jsonld": [{"@context": "https://schema.org", "@type": "MusicGroup", "@id": "https://ioana-balan.ro/#artist", "name": "Ioana Balan", "url": "https://ioana-balan.ro/", "description": "Solistă de muzică populară și de petrecere, cu formație live de trei până la șase instrumente, interpreți pentru muzică ușoară și balcanică, DJ, MC și producție tehnică proprie: sonorizare, lumini și efecte de scenă.", "genre": ["Muzică populară", "Muzică de petrecere", "Folclor", "Muzică ușoară"], "member": [{"@type": "OrganizationRole", "roleName": "Solistă, muzică populară și de petrecere", "member": {"@type": "Person", "name": "Ioana Balan"}}], "foundingLocation": {"@type": "Place", "name": "București, România"}, "telephone": "+40722911485", "email": "ioanabalanoficial@gmail.com", "sameAs": ["https://www.facebook.com/ioanabalanoficial", "https://www.instagram.com/ioanabalanoficial/", "https://www.tiktok.com/@ioanabalanmusic", "https://www.youtube.com/channel/UCNTWODu5imMryMhkbbw6vEQ", "https://ro.pinterest.com/ioanabalanoficial/"]}], "h1": "Cine urcă pe scenă: instrumente, voci, DJ și echipa tehnică", "title": "Formația"}, "elements": [{"id": "form008", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "__globals__": {}, "custom_css": "selector{border-bottom:1px solid rgba(68,71,72,.1)}selector{background-position:center 6%}", "padding": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "