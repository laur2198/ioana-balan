 {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "width": {"unit": "px", "size": 768, "sizes": []}, "width_mobile": {"unit": "%", "size": 100, "sizes": []}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "48", "left": "0", "isLinked": false}, "margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "48", "left": "0", "isLinked": false}, "margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "32", "left": "0", "isLinked": false}, "custom_css": "selector{max-width:100%}"}, "elements": [{"id": "zolt00c", "elType": "widget", "widgetType": "heading", "settings": {"title": "Acoperire", "header_size": "div", "title_color": "#C6C6C6", "typography_typography": "custom", "typography_font_family": "Inter", "typography_font_size": {"unit": "px", "size": 14, "sizes": []}, "typography_font_weight": "600", "typography_text_transform": "uppercase", "typography_letter_spacing": {"unit": "em", "size": 0.2, "sizes": []}, "typography_line_height": {"unit": "px", "size": 20, "sizes": []}, "__globals__": {"title_color": "globals/colors?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}}, "elements": []}, {"id": "zolt00d", "elType": "widget", "widgetType": "heading", "settings": {"title": "Tot județul, pe o singură direcție", "header_size": "h2", "title_color": "#E5E2E1", "__globals__": {"title_color": "globals/colors?id=primary", "typography_typography": "globals/typography?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_element_id": "localitati-titlu"}, "elements": []}, {"id": "zolt00e", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Slatina și Piatra-Olt sunt în nordul județului, cel mai aproape de București pe A1 și DN65. Balș rămâne spre vest, Caracalul la mijloc, iar Corabia și Dăbuleni închid axa la fluviu. Scornicești, Drăgănești-Olt și Potcoava se împart între ele.</p>", "text_color": "#C6C6C6", "custom_css": "selector p{margin:0}", "__globals__": {"text_color": "globals/colors?id=secondary", "typography_typography": "globals/typography?id=quote"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": []}], "isInner": true}, {"id": "zolt010", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><div class=\"glass-card silver-border p-6 md:p-10 max-w-4xl\">\n<ul class=\"motif-list grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-4\">\n<li class=\"font-body-lg text-base md:text-body-lg\">Slatina</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Caracal</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Corabia</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Balș</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Scornicești</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Drăgănești-Olt</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Piatra-Olt</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Potcoava</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Osica de Sus</li>\n</ul>\n<div class=\"motif-rule max-w-[180px] w-full mt-8\"><span class=\"motif-rule__gem zona-gem\"></span></div>\n<p class=\"font-body-md text-body-md text-on-surface-variant mt-6\">Pentru o comună care nu e pe listă, reperul e poziția pe axă: nordul se deservește dinspre Pitești, sudul dinspre Caracal. Nu există drum scurt care să sară peste mijloc.</p>\n</div></div>"}, "elements": []}, {"id": "zolt011", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>În susul aceleiași văi, dincolo de Slatina, începe <a href=\"/zone/valcea/\">Vâlcea</a>. Spre vest, Balșul e la o jumătate de oră de <a href=\"/zone/dolj/\">Dolj</a>, pe DN65. Spre est, peste râu, drumul intră în <a href=\"/zone/teleorman/\">Teleorman</a>, pe direcția Roșiori.</p>", "text_color": "#C6C6C6", "custom_css": "selector p{margin:0}selector{max-width:768px !important}", "__globals__": {"text_color": "globals/colors?id=secondary", "typography_typography": "globals/typography?id=text"}, "_margin": {"unit": "px", "top": "32", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "32", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "32", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": []}, {"id": "zolt012", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><p class=\"mt-8\"><a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex flex-wrap items-center gap-2 min-h-[44px]\" href=\"/zone/\">Toate zonele deservite</a></p></div>"}, "elements": []}], "isInner": false}, {"id": "zolt015", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "i