raphy_text_transform": "uppercase", "typography_letter_spacing": {"unit": "em", "size": 0.2, "sizes": []}, "typography_line_height": {"unit": "px", "size": 20, "sizes": []}, "__globals__": {"title_color": "globals/colors?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}}, "elements": []}, {"id": "zolt017", "elType": "widget", "widgetType": "heading", "settings": {"title": "O melodie de joc plină, nu una simplă", "header_size": "h2", "title_color": "#E5E2E1", "__globals__": {"title_color": "globals/colors?id=primary", "typography_typography": "globals/typography?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "24", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "24", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "24", "left": "0", "isLinked": false}, "_element_id": "repertoriu-titlu"}, "elements": []}, {"id": "zolt018", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Melodia de joc oltenească e densă, cu multe note de trecere — nu una care se ține din câteva sunete lungi. Asta se aude cel mai clar la vioară și la voce, care duc linia împreună, și se simte la ureche ca o petrecere „plină”, chiar când ansamblul e același ca în alte zone.</p>", "text_color": "#C6C6C6", "custom_css": "selector p{margin:0}", "__globals__": {"text_color": "globals/colors?id=secondary", "typography_typography": "globals/typography?id=quote"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": []}, {"id": "zolt019", "elType": "widget", "widgetType": "heading", "settings": {"title": "Ce cere asta de la formație", "header_size": "h3", "title_color": "#E5E2E1", "__globals__": {"title_color": "globals/colors?id=primary", "typography_typography": "globals/typography?id=lead"}, "_margin": {"unit": "px", "top": "36", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "36", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "36", "right": "0", "bottom": "16", "left": "0", "isLinked": false}}, "elements": []}, {"id": "zolt01a", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>O linie densă nu iartă aproximările: dacă notele de trecere se pierd, jocul rămâne pe schelet și sună a altă regiune. De aceea blocul oltenesc nu se citește la prima vedere, ci se repetă. <span class=\"ph\">[angajament de confirmat de client — B79]</span> Peste el, horele se joacă prinși de mână, în cerc strâns, la tempouri mai iuți decât cele muntenești. Dacă și cât se schimbă registrul între malul drept și malul stâng al Oltului e o întrebare la care nu răspundem din birou: <span class=\"ph\">[afirmație de folclor — de validat de Ioana]</span></p>", "text_color": "#C6C6C6", "custom_css": "selector p{margin:0}", "__globals__": {"text_color": "globals/colors?id=secondary", "typography_typography": "globals/typography?id=quote"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": []}, {"id": "zolt01b", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><p class=\"mt-8\"><a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex flex-wrap items-center gap-2 min-h-[44px]\" href=\"/repertoriu/\">Vezi repertoriul complet</a></p></div>"}, "elements": []}], "isInner": true}], "isInner": false}, {"id": "zolt01f", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_