": []}, "width_mobile": {"unit": "%", "size": 100, "sizes": []}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "48", "left": "0", "isLinked": false}, "margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "48", "left": "0", "isLinked": false}, "margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "32", "left": "0", "isLinked": false}, "custom_css": "selector{max-width:100%}"}, "elements": [{"id": "zolt020", "elType": "widget", "widgetType": "heading", "settings": {"title": "Logistică", "header_size": "div", "title_color": "#C6C6C6", "typography_typography": "custom", "typography_font_family": "Inter", "typography_font_size": {"unit": "px", "size": 14, "sizes": []}, "typography_font_weight": "600", "typography_text_transform": "uppercase", "typography_letter_spacing": {"unit": "em", "size": 0.2, "sizes": []}, "typography_line_height": {"unit": "px", "size": 20, "sizes": []}, "__globals__": {"title_color": "globals/colors?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}}, "elements": []}, {"id": "zolt021", "elType": "widget", "widgetType": "heading", "settings": {"title": "Totul se măsoară pe axa nord–sud", "header_size": "h2", "title_color": "#E5E2E1", "__globals__": {"title_color": "globals/colors?id=primary", "typography_typography": "globals/typography?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_element_id": "logistica-titlu"}, "elements": []}, {"id": "zolt022", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Un eveniment la Slatina și unul la Corabia se organizează la fel, dar nu costă la fel: între ele e toată lungimea județului. Nu există trecători, nu există ocolire — doar distanță. Se contorizează drumul dus-întors, cu 6 lei pentru fiecare kilometru.</p>", "text_color": "#C6C6C6", "custom_css": "selector p{margin:0}", "__globals__": {"text_color": "globals/colors?id=secondary", "typography_typography": "globals/typography?id=text"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": []}], "isInner": true}, {"id": "zolt024", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><div class=\"grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-gutter max-w-4xl\">\n<div class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Distanță</span>\n<p class=\"font-display-lg text-3xl md:text-4xl text-on-surface\">~165–180 km din București</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Cifra se ia din aceeași măsurătoare aplicată tuturor județelor. Fără cifră, ce se poate spune e că Slatina e capătul apropiat al județului, iar Corabia cel îndepărtat — diferența dintre ele intră direct în ofertă.</p>\n</div>\n<div class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Deplasare</span>\n<p class=\"font-headline-md text-xl md:text-headline-md text-on-surface\">Echipa tehnică pleacă înaintea interpreților</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Întâi urcă în mașină schela, luminile și sonorizarea, cu oamenii care le montează; interpreții pornesc mai târziu, ca să nu aștepte la locație. Pentru sudul județului, plecarea se mută mai devreme cu câteva ore, nu cu o zi.</p>\n</div>\n<div class=\"glass-card silver-border p-6 md:p-8 md:col-span-2 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Cazare</span>\n<p class=\"font-headline-md text-xl md:text-headline-md text-on-surface\">Depinde de capătul în care e sala</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Pentru Slatina și nordul județului, la un program care se încheie la ora obișnuită, capitolul poate lipsi de pe ofertă. Pentru Corabia și sudul apropiat de Dunăre, se discută. Cine suportă camerele, atunci când sunt necesare, se stabilește înainte, la discuția de organizare. <span class=\"ph\">[CAZARE OLT — de confirmat]</span></p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">E singura variabilă din județ care nu se poate anunța dinainte pe pagină: depinde de localitate și de ora de final, nu de tipul evenimentului.</p>\n</div>\n</div></div>"}, "elements": []}], "isInner": false}, {"id": "zolt027", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "0", "right": "24", "bottom": "0", "left": "24", "isLinked": false}}, "elements": [{"id": "zolt026", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"zona-divider\"></div>"}, "elements": []}], "isInner": false}, {"id": "zolt029", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}}, "elements": [{"id": "zolt028", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><div class=\"max-w-3xl mx-auto glass-card silver-border p-6 md:p-12 text-center flex flex-col items-center gap-5\">\n<span class=\"font-label-md text-label-md text-primary uppercase tracking-[0.2em]\">Pachete</span>\n<h2 class=\"font-headline-lg text-2xl md:text-headline-lg leading-tight\" id=\"pachete-titlu\">Aceeași grilă, alt kilometraj</h2>\n<p class=\"font-body-lg text-base md:text-body-lg text-on-surface-variant\">Pachetele nu se schimbă între nordul și sudul județului. Ce se schimbă e linia de transport, iar ea se calculează pe adresa exactă a sălii, nu pe numele județului.</p>\n\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Programul se construiește pe ocazie, nu pe kilometraj: o <a class=\"text-primary underline underline-offset-4 hover:text-white transition-colors\" href=\"/nunta/\">nuntă</a>, un <a class=\"text-primary underline underline-offset-4 hover:text-white transition-colors\" href=\"/botez/\">botez</a>, o <a class=\"text-primary underline underline-offset-4 hover:text-white transition-colors\" href=\"/eveniment-privat/\">cumetrie</a> sau o <a class=\"text-primary underline underline-offset-4 hover:text-white transition-colors\" href=\"/corporate/\">seară corporate</a>.</p>\n<div class=\"motif-rule max-w-[180px] w-full\"><span class=\"motif-rule__gem zona-gem\"></span></div>\n<div class=\"flex flex-col sm:flex-row gap-4 w-full sm:w-auto\">\n<a class=\"inline-block text-center whitespace-nowrap bg-accent text-white px-8 md:px-10 py-4 uppercase font-label-md text-label-md tracking-widest hover:bg-accent-hover transition-colors w-full sm:w-auto\" href=\"/oferte/\">Vezi toate pachetele</a>\n<a class=\"btn-secundar-zona inline-block text-center whitespace-nowrap text-on-surface bg-transparent px-8 md:px-10 py-4 uppercase font-label-md text-label-md tracking-widest hover:bg-white/5 transition-colors w-full sm:w-auto\" href=\"/contact/\">Cere ofertă</a>\n</div>\n</div></div>"}, "elements": []}], "isInner": false}, {"id": "zolt02b", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "0", "right": "24", "bottom": "0", "left": "24", "isLinked": false}}, "elements": [{"id": "zolt02a", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"zona-divider\"></div>"}, "elements": []}], "isInner": false}, {"id": "zolt036", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 