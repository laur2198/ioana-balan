izes": []}, "typography_font_weight": "600", "typography_text_transform": "uppercase", "typography_letter_spacing": {"unit": "em", "size": 0.2, "sizes": []}, "typography_line_height": {"unit": "px", "size": 20, "sizes": []}, "__globals__": {"title_color": "globals/colors?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}}, "elements": []}, {"id": "zbuz00e", "elType": "widget", "widgetType": "heading", "settings": {"title": "Câmpie, deal și munte, în opt localități", "header_size": "h2", "title_color": "#E5E2E1", "__globals__": {"title_color": "globals/colors?id=primary", "typography_typography": "globals/typography?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_element_id": "localitati-titlu"}, "elements": []}, {"id": "zbuz00f", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Buzău, Vernești și Merei sunt în jurul reședinței de județ, la capătul drumului din București. Pogoanele e la câmpie, în sud. Berca și Pătârlagele urcă pe valea Buzăului, iar Nehoiu e cel mai sus, la munte. Râmnicu Sărat stă separat, pe DN2, spre Focșani.</p>", "text_color": "#C6C6C6", "custom_css": "selector p{margin:0}", "__globals__": {"text_color": "globals/colors?id=secondary", "typography_typography": "globals/typography?id=quote"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": []}], "isInner": true}, {"id": "zbuz011", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><div class=\"glass-card silver-border p-6 md:p-10 max-w-4xl\">\n<ul class=\"motif-list grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-4\">\n<li class=\"font-body-lg text-base md:text-body-lg\">Buzău</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Râmnicu Sărat</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Nehoiu</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Pogoanele</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Pătârlagele</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Merei</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Vernești</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Berca</li>\n</ul>\n<div class=\"motif-rule max-w-[180px] w-full mt-8\"><span class=\"motif-rule__gem zona-gem\"></span></div>\n<p class=\"font-body-md text-body-md text-on-surface-variant mt-6\">Nehoiu și Pătârlagele sunt singurele din listă unde drumul de munte schimbă calculul. Pentru o localitate buzoiană care lipsește, spuneți-ne dacă e la câmpie, în deal sau sus, pe vale — de acolo pornim.</p>\n</div></div>"}, "elements": []}, {"id": "zbuz012", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Trei localități de pe listă deschid, fiecare, drumul spre alt județ. Nehoiu e pe DN10, care urcă valea, trece munții și coboară în Țara Bârsei, spre <a href=\"/zone/brasov/\">Brașov</a>. Merei ține de Dealu Mare, podgoria împărțită cu <a href=\"/zone/prahova/\">Prahova</a>, cu Urlați și Valea Călugărească pe partea cealaltă. Pogoanele stă pe DN2C, șoseaua de câmpie care duce la Slobozia, în <a href=\"/zone/ialomita/\">Ialomița</a>.</p>", "text_color": "#C6C6C6", "custom_css": "selector p{margin:0}selector{max-width:768px !important}", "__globals__": {"text_color": "globals/colors?id=secondary", "typography_typography": "globals/typography?id=text"}, "_margin": {"unit": "px", "top": "32", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "32", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "32", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": []}, {"id": "zbuz013", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><p class=\"mt-8\"><a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex flex-wrap items-center gap-2 min-h-[44px]\" href=\"/zone/\">Toate zonele deservite</a></p></div>"}, "elements": []}], "isInner": false}, {"id": "zbuz016", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "0", "right": "24", "bottom": "0", "left": "24", "isLinked": false}}, "elements": [{"id": "zbuz015", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"zona-divider\"></div>"}, "elements": []}], "isInner": false}, {"id": "zbuz018", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}}, "elements": [{"id": "zbuz017", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><div class=\"max-w-3xl\">\n<span class=\"font-label-md text-label-md text-primary uppercase tracking-[0.2em] block mb-4\">Repertoriu</span>\n<h2 class=\"font-headline-lg text-2xl md:text-headline-lg leading-tight mb-6\" id=\"repertoriu-titlu\">Unde Muntenia se întâlnește cu Moldova</h2>\n<p class=\"font-body-lg text-base md:text-body-lg text-on-surface-variant\">Buzăul aparține Munteniei de sub munte, cu repertoriul muntenesc ca fond și cu influențele zonei subcarpatice de curbură: cântece de deal, mai lungi la masă, și jocuri de pe văile care coboară din munte. Ce îl deosebește de Prahova sau de Argeș e vecinul care se aude cel mai tare: Moldova, prin Vrancea.</p>\n<h3 class=\"font-headline-md text-lg md:text-headline-md text-on-surface leading-snug mt-9 mb-4\">Cum arată asta într-un program de nuntă</h3>\n<p class=\"font-body-lg text-base md:text-body-lg text-on-surface-variant\">Spre Râmnicu Sărat, gazdele pot cere hore și sârbe moldovenești alături de cele muntenești, iar cântecul de masă poate avea inflexiunile de dincolo de Milcov, vechea graniță dintre cele două țări românești. Pe valea Buzăului, spre Nehoiu, cererile merg mai degrabă spre cântecul de munte. În același județ, două nunți pot cere așadar dozaje diferite, și de aceea întrebăm întâi de unde sunt familiile.</p>\n\n<p class=\"mt-8\"><a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex flex-wrap items-center gap-2 min-h-[44px]\" href=\"/repertoriu/\">Vezi repertoriul complet</a></p>\n</div></div>"}, "elements": []}], "isInner": false}, {"id": "zbuz01a", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "0", "right": "24", "bottom": "0", "left": "24", "isLinked": false}}, "elements": [{"id": "zbuz019", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"zona-divider\"></div>"}, "elements": []}], "isInner": false}, {"id": "zbuz020", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}}, "elements": [{"id": "zbuz01e", "elType": "container", "settings": {"container_type": "flex", "content_width": "full", "flex_direction": "column", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "width": {"unit": "px", "size": 768, "sizes": []}, "width_mobile": {"unit": "%", "size": 100, "sizes": []}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "48", "left": "0", "isLinked": false}, "margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "48", "left": "0", "isLinked": false}, "margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "32", "left": "0", "isLinked": false}, "custom_css": "selector{max-width:100%}"}, "elements": [{"id": "zbuz01b", "elType": "widget", "widgetType": "heading", "settings": {"title": "Logistică", "header_size": "div", "title_color": "#C6C6C6", "typography_typography": "custom", "typography_font_family": "Inter", "typography_font_size": {"unit": "px", "size": 14, "sizes": []}, "typography_font_weight": "600", "typography_text_transform": "uppercase", "typography_letter_spacing": {"unit": "em", "size": 0.2, "sizes": []}, "typography_line_height": {"unit": "px", "size": 20, "sizes": []}, "__globals__": {"title_color": "globals/colors?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}}, "elements": []}, {"id": "zbuz01c", "elType": "widget", "widgetType": "heading", "settings": {"title": "Câmpia e simplă, valea cere planificare", "header_size": "h2", "title_color": "#E5E2E1", "__globals__": {"title_color": "globals/colors?id=primary", "typography_typography": "globals/typography?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_element_id": "logistica-titlu"}, "elements": []}, {"id": "zbuz01d", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Până la Buzău drumul e lung, dar fără dificultăți; greul, dacă există, începe abia după oraș, pe valea spre Nehoiu. Suplimentul de transport e de 6 lei/km și se plătește pe drumul întreg, dus și întors.</p>", "text_color": "#C6C6C6", "custom_css": "selector p{margin:0}", "__globals__": {"text_color": "globals/colors?id=secondary", "typography_typography": "globals/typography?id=text"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": []}], "isInner": true}, {"id": "zbuz01f", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><div class=\"grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-gutter max-w-4xl\">\n<div class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Distanță</span>\n<p class=\"font-display-lg text-3xl md:text-4xl text-on-surface\">~110 km</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Până la Buzău, pe DN2 prin Urziceni sau pe la Ploiești, pe DN1B. Râmnicu Sărat e la circa 40 km mai departe pe DN2; Nehoiu, pe DN10, adaugă în jur de o oră și jumătate de drum de munte.</p>\n</div>\n<div class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Deplasare</span>\n<p class=\"font-headline-md text-xl md:text-headline-md text-on-surface\">Pe DN10, cu marjă de vale</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Echipamentul pleacă primul, ca întotdeauna. Pentru localitățile de pe valea Buzăului se adaugă timp pentru un drum îngust, cu curbe și cu multe traversări de sate, pe care o mașină încărcată cu sonorizare nu merge în ritmul unui autoturism.</p>\n</div>\n<div class=\"glass-card silver-border p-6 md:p-8 md:col-span-2 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Cazare</span>\n<p class=\"font-headline-md text-xl md:text-headline-md text-on-surface\">De discutat pentru valea Buzăului</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">La Buzău, Vernești sau Merei, echipa se întoarce după demontare în aceeași noapte. La Nehoiu și Pătârlagele, după un program care se termină târziu, urmează un drum de munte făcut noaptea, după o zi întreagă de lucru — motiv pentru care cazarea se pune pe lista discuției de organizare.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Dacă se ajunge la ea, forma concretă a cazării se hotărăște acolo, după distanță, după tipul evenimentului și după preferința mirilor.</p>\n</div>\n</div></div>"}, "elements": []}], "isInner": false}, {"id": "zbuz022", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "0", "right": "24", "bottom": "0", "left": "24", "isLinked": false}}, "elements": [{"id": "zbuz021", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"zona-divider\"></div>"}, "elements": []}], "isInner": false}, {"id": "zbuz024", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}}, "elements": [{"id": "zbuz023", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><div class=\"max-w-3xl mx-auto glass-card silver-border p-6 md:p-12 text-center flex flex-col items-center gap-5\">\n<span class=\"font-label-md text-label-md text-primary uppercase tracking-[0.2em]\">Pachete</span>\n<h2 class=\"font-headline-lg text-2xl md:text-headline-lg leading-tight\" id=\"pachete-titlu\">De la oraș la munte, același pachet</h2>\n<p class=\"font-body-lg text-base md:text-body-lg text-on-surface-variant\">Configurația de pachet nu depinde de relief. Pentru Buzău și pentru localitățile de câmpie, oferta adaugă doar transportul; pentru valea Buzăului poate adăuga și cazarea, iar asta apare scris în ofertă de la prima versiune.</p>\n\n<p class=\"font-body-md text-body-md text-on-surface-variant\">La Nehoiu sau la Pogoanele, după localitate vine întrebarea ce anume sărbătoriți — <a class=\"text-primary underline underline-offset-4 hover:text-white transition-colors\" href=\"/botez/\">un botez</a>, <a class=\"text-primary underline underline-offset-4 hover:text-white transition-colors\" href=\"/nunta/\">o nuntă</a>, <a class=\"text-primary underline underline-offset-4 hover:text-white transition-colors\" href=\"/eveniment-privat/\">o zi de naștere în familie</a> sau <a class=\"text-primary underline underline-offset-4 hover:text-white transition-colors\" href=\"/corporate/\">un eveniment al firmei</a> —, pentru că de răspuns depinde cât durează programul și, la munte, dacă mai e nevoie de cazare.</p>\n<div class=\"motif-rule max-w-[180px] w-full\"><span class=\"motif-rule__gem zona-gem\"></span></div>\n<div class=\"flex flex-col sm:flex-row gap-4 w-full sm:w-auto\">\n<a class=\"inline-block text-center whitespace-nowrap bg-accent text-white px-8 md:px-10 py-4 uppercase font-label-md text-label-md tracking-widest hover:bg-accent-hover transition-colors w-full sm:w-auto\" href=\"/oferte/\">Vezi toate pachetele</a>\n<a class=\"btn-secundar-zona inline-block text-center whitespace-nowrap text-on-surface bg-transparent px-8 md:px-10 py-4 uppercase font-label-md text-label-md tracking-widest hover:bg-white/5 transition-colors w-full sm:w-auto\" href=\"/contact/\">Cere ofertă</a>\n</div>\n</div></div>"}, "elements": []}], "isInner": false}, {"id": "zbuz026", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "0", "right": "24", "bottom": "0", "left": "24", "isLinked": false}}, "elements": [{"id": "zbuz025", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"zona-divider\"></div>"}, "elements": []}], "isInner": false}, {"id": "zbuz031", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}}, "elements": [{"id": "zbuz029", "elType": "container", "settings": {"container_type": "flex", "content_width": "full", "flex_direction": "column", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "width": {"unit": "px", "size": 768, "sizes": []}, "width_mobile": {"unit": "%", "size": 100, "sizes": []}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "48", "left": "0", "isLinked": false}, "margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "48", "left": "0", "isLinked": false}, "margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "32", "left": "0", "isLinked": false}, "custom_css": "selector{max-width:100%}"}, "elements": [{"id": "zbuz027", "elType": "widget", "widgetType": "heading", "settings": {"title": "Întrebări", "header_size": "div", "title_color": "#C6C6C6", "typography_typography": "custom", "typography_font_family": "Inter", "typography_font_size": {"unit": "px", "size": 14, "sizes": []}, "typography_font_weight": "600", "typography_text_transform": "uppercase", "typography_letter_spacing": {"unit": "em", "size": 0.2, "sizes": []}, "typography_line_height": {"unit": "px", "size": 20, "sizes": []}, "__globals__": {"title_color": "globals/colors?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}}, "elements": []}, {"id": "zbuz028", "elType": "widget", "widgetType": "heading", "settings": {"title": "Întrebări despre vale, câmpie și Râmnicu Sărat", "header_size": "h2", "title_color": "#E5E2E1", "__globals__": {"title_color": "globals/colors?id=primary", "typography_typography": "globals/typography?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "_element_id": "faq-titlu"}, "elements": []}], "isInner": true}, {"id": "zbuz02f", "elType": "container", "settings": {"container_type": "flex", "content_width": "full", "flex_direction": "column", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "width": {"unit": "px", "size": 768, "sizes": []}, "width_mobile": {"unit": "%", "size": 100, "sizes": []}, "custom_css": "selector{max-width:100%}", "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": [{"id": "zbuz02a", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"faq-item\"><details open><summary aria-expanded=\"true\"><h3>Familia mirelui e din Vrancea. Puteți cânta moldovenește fără să pierdem partea muntenească?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 -960 960 960\" fill=\"currentColor\"><path d=\"M480-357.85 253.85-584l32.61-32.61L480-423.08l193.54-193.53L706.15-584 480-357.85Z\"/></svg></summary><div class=\"faq-item__answer\"><p>Da, și la Buzău amestecul e mai firesc decât oriunde altundeva în Muntenia, pentru că cele două repertorii se ating chiar aici. Blocul muntenesc rămâne baza pentru toată sala, iar horele și sârbele moldovenești intră ca set propriu, în momentul în care familia mirelui e la ring.</p>\n<p>Ajută mult dacă aflăm din ce parte a Vrancei sunt rudele și ce piese se cântă la ei la nunți.</p></div></details></div>", "custom_css": "selector{margin-bottom:16px}selector h3{margin:0;padding-right:16px;font-family:\"EB Garamond\",Georgia,serif;font-size:16px;font-weight:500;line-height:1.375;color:var(--e-global-color-primary)}@media(min-width:768px){selector h3{font-size:24px}}selector .faq-item__answer{font-family:Inter,sans-serif;font-size:16px;line-height:1.6}selector .faq-item__answer p{margin:0}selector .faq-item__answer p+p{margin-top:12px}"}, "elements": []}, {"id": "zbuz02b", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"faq-item\"><details><summary aria-expanded=\"false\"><h3>Petrecerea e la o pensiune de pe valea Buzăului, spre Nehoiu. Încape sonorizarea?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 -960 960 960\" fill=\"currentColor\"><path d=\"M480-357.85 253.85-584l32.61-32.61L480-423.08l193.54-193.53L706.15-584 480-357.85Z\"/></svg></summary><div class=\"faq-item__answer\"><p>Pensiunile de munte au de obicei săli mai mici decât restaurantele de oraș, deci sonorizarea se dimensionează pe spațiul real, nu pe pachetul standard. Trimiteți-ne dimensiunile aproximative ale sălii și numărul de invitați.</p>\n<p>Verificați și accesul: dacă sala e la etaj sau la capătul unei scări exterioare, montajul durează mai mult decât cele 4–5 ore obișnuite.</p></div></details></div>", "custom_css": "selector{margin-bottom:16px}selector h3{margin:0;padding-right:16px;font-family:\"EB Garamond\",Georgia,serif;font-size:16px;font-weight:500;line-height:1.375;color:var(--e-global-color-primary)}@media(min-width:768px){selector h3{font-size:24px}}selector .faq-item__answer{font-family:Inter,sans-serif;font-size:16px;line-height:1.6}selector .faq-item__answer p{margin:0}selector .faq-item__answer p+p{margin-top:12px}"}, "elements": []}, {"id": "zbuz02c", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"faq-item\"><details><summary aria-expanded=\"false\"><h3>La noi, prima parte a serii e cu cântece la masă, nu cu joc. Cât ține?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 -960 960 960\" fill=\"currentColor\"><path d=\"M480-357.85 253.85-584l32.61-32.61L480-423.08l193.54-193.53L706.15-584 480-357.85Z\"/></svg></summary><div class=\"faq-item__answer\"><p>Cât vreți dumneavoastră. Repertoriul de sub munte are cântece de masă mai lungi și mai așezate decât muzica de câmpie, iar invitații în vârstă le ascultă cu plăcere înainte să se ridice la joc. De obicei partea asta se încheie când se servește felul principal.</p>\n<p>Dacă sala e amestecată, o scurtăm și intrăm mai devreme în hore, ca tinerii să nu aștepte prea mult ringul.</p></div></details></div>", "custom_css": "selector{margin-bottom:16px}selector h3{margin:0;padding-right:16px;font-family:\"EB Garamond\",Georgia,serif;font-size:16px;font-weight:500;line-height:1.375;color:var(--e-global-color-primary)}@media(min-width:768px){selector h3{font-size:24px}}selector .faq-item__answer{font-family:Inter,sans-serif;font-size:16px;line-height:1.6}selector .faq-item__answer p{margin:0}selector .faq-item__answer p+p{margin-top:12px}"}, "elements": []}, {"id": "zbuz02d", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"faq-item\"><details><summary aria-expanded=\"false\"><h3>Sala e la Râmnicu Sărat, pe DN2, unde circulă multe camioane. Ajungeți la timp?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 -960 960 960\" fill=\"currentColor\"><path d=\"M480-357.85 253.85-584l32.61-32.61L480-423.08l193.54-193.53L706.15-584 480-357.85Z\"/></svg></summary><div class=\"faq-item__answer\"><p>Da. DN2 e drumul principal spre Moldova și are trafic greu în orice zi, așa că plecarea echipei tehnice se calculează pe viteza reală a traseului, nu pe kilometri. Spre seară, la întoarcere, drumul e mai liber.</p>\n<p>Ca să stabilim ora de plecare, ne trebuie ora de la care sala e disponibilă pentru montaj.</p></div></details></div>", "custom_css": "selector{margin-bottom:16px}selector h3{margin:0;padding-right:16px;font-family:\"EB Garamond\",Georgia,serif;font-size:16px;font-weight:500;line-height:1.375;color:var(--e-global-color-primary)}@media(min-width:768px){selector h3{font-size:24px}}selector .faq-item__answer{font-family:Inter,sans-serif;font-size:16px;line-height:1.6}selector .faq-item__answer p{margin:0}selector .faq-item__answer p+p{margin-top:12px}"}, "elements": []}, {"id": "zbuz02e", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"faq-item\"><details><summary aria-expanded=\"false\"><h3>Cât e diferența de preț între o nuntă în orașul Buzău și una la Nehoiu?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 -960 960 960\" fill=\"currentColor\"><path d=\"M480-357.85 253.85-584l32.61-32.61L480-423.08l193.54-193.53L706.15-584 480-357.85Z\"/></svg></summary><div class=\"faq-item__answer\"><p>Diferența vine din două surse. Prima sunt kilometrii: Nehoiu e la aproximativ 70 km de Buzău, deci în jur de 140 km în plus pe traseul dus-întors, înmulțiți cu tariful de transport. A doua e cazarea, dacă programul se termină târziu și se decide ca echipa să rămână.</p>\n<p>Pachetul muzical e același în ambele cazuri. Vă putem trimite două oferte, una pentru fiecare variantă, dacă încă alegeți locația.</p></div></details></div>", "custom_css": "selector{margin-bottom:16px}selector h3{margin:0;padding-right:16px;font-family:\"EB Garamond\",Georgia,serif;font-size:16px;font-weight:500;line-height:1.375;color:var(--e-global-color-primary)}@media(min-width:768px){selector h3{font-size:24px}}selector .faq-item__answer{font-family:Inter,sans-serif;font-size:16px;line-height:1.6}selector .faq-item__answer p{margin:0}selector .faq-item__answer p+p{margin-top:12px}"}, "elements": []}], "isInner": true}, {"id": "zbuz030", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><div class=\"mt-10 md:mt-12\">\n<a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex items-center gap-2 min-h-[44px]\" href=\"/faq/\">Vezi toate întrebările frecvente <svg aria-hidden=\"true\" class=\"text-[18px]\" fill=\"currentColor\" height=\"1em\" style=\"vertical-align:-.125em\" viewbox=\"0 -960 960 960\" width=\"1em\"><path d=\"M693.69-457.31H180v-45.38h513.69L448.39-748 480-780l300 300-300 300-31.61-32 245.3-245.31Z\"></path></svg></a>\n</div></div>"}, "elements": []}], "isInner": false}, {"id": "zbuz035", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 544, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#1C1B1B", "__globals__": {"background_color": "globals/colors?id=surfacealt"}, "custom_css": "selector{background-color:#1C1B1B}selector{border-top:1px solid rgba(68,71,72,.1)}selector{text-align:center}", "padding": {"unit": "px", "top": "96", "right": "64", "bottom": "96", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "96", "right": "64", "bottom": "96", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "64", "right": "24", "bottom": "64", "left": "24", "isLinked": false}}, "elements": [{"id": "zbuz032", "elType": "widget", "widgetType": "heading", "settings": {"title": "Oraș, câmpie sau vale? Scrieți-ne", "header_size