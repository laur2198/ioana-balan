"16", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_element_id": "localitati-titlu"}, "elements": []}, {"id": "zmeh011", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Drobeta-Turnu Severin e reședința și nodul de drum. Strehaia, Vânju Mare și Cujmir rămân în câmpia dinspre Dolj, Șimian și Gruia pe malul fluviului, iar Orșova și Baia de Aramă urcă spre munte, una pe Dunăre, cealaltă spre Podișul Mehedinți.</p>", "text_color": "#C6C6C6", "custom_css": "selector p{margin:0}", "__globals__": {"text_color": "globals/colors?id=secondary", "typography_typography": "globals/typography?id=quote"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": []}], "isInner": true}, {"id": "zmeh013", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><div class=\"glass-card silver-border p-6 md:p-10 max-w-4xl\">\n<ul class=\"motif-list grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-4\">\n<li class=\"font-body-lg text-base md:text-body-lg\">Drobeta-Turnu Severin</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Orșova</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Strehaia</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Vânju Mare</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Baia de Aramă</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Șimian</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Cujmir</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Gruia</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Broșteni</li>\n</ul>\n<div class=\"motif-rule max-w-[180px] w-full mt-8\"><span class=\"motif-rule__gem zona-gem\"></span></div>\n<p class=\"font-body-md text-body-md text-on-surface-variant mt-6\">Pentru o comună care nu apare aici, întrebarea e pe ce drum se intră: cele din câmpie se deservesc dinspre Craiova, cele de pe fluviu pe DN57, iar cele din nord pe drumul spre Baia de Aramă. Distanța dintre capete e mai mare decât pare pe hartă.</p>\n</div></div>"}, "elements": []}, {"id": "zmeh014", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Spre est, câmpia continuă fără graniță vizibilă în <a href=\"/zone/dolj/\">Dolj</a>: DN6 leagă Drobeta de Craiova și e ruta pe care intră majoritatea invitaților veniți din țară. Mai departe, pe aceeași direcție, drumul urcă spre <a href=\"/zone/valcea/\">Vâlcea</a>, pe valea Oltului.</p>", "text_color": "#C6C6C6", "custom_css": "selector p{margin:0}selector{max-width:768px}", "__globals__": {"text_color": "globals/colors?id=secondary", "typography_typography": "globals/typography?id=text"}, "_margin": {"unit": "px", "top": "32", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "32", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "32", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": []}, {"id": "zmeh015", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><p class=\"mt-8\"><a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex flex-wrap items-center gap-2 min-h-[44px]\" href=\"/zone/\">Toate zonele deservite</a></p></div>"}, "elements": []}], "isInner": false}, {"id": "zmeh018", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "0", "right": "24", "bottom": "0", "left": "24", "isLinked": false}}, "elements": [{"id": "zmeh017", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"zona-divider\"></div>"}, "elements": []}], "isInner": false}, {"id": "zmeh01a", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}}, "elements": [{"id": "zmeh019", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><div class=\"max-w-3xl\">\n<span class=\"font-label-md text-label-md text-primary uppercase tracking-[0.2em] block mb-4\">Repertoriu</span>\n<h2 class=\"font-headline-lg text-2xl md:text-headline-lg leading-tight mb-6\" id=\"repertoriu-titlu\">Sârbe mărunte și figuri de bărbați</h2>\n<p class=\"font-body-lg text-base md:text-body-lg text-on-surface-variant\">Și Mehedințiul e Oltenie, iar de aici vine un fel anume de sârbă și de brâuleț: pas mărunt, bătut în podea, cu momente lăsate anume pentru bărbați — sărit, pinten, lovitură din călcâi. E singura parte din seară care nu se joacă de toată lumea deodată: se face loc la mijloc, intră cine știe, restul privește. Tocmai de asta se și vede cel mai bine.</p>\n<h3 class=\"font-headline-md text-lg md:text-headline-md text-on-surface leading-snug mt-9 mb-4\">Ce înseamnă asta pentru ordinea serii</h3>\n<p class=\"font-body-lg text-base md:text-body-lg text-on-surface-variant\">Un bloc cu figuri nu se pune la începutul petrecerii, când sala e încă la mese, și nici la final, când ringul e obosit. Stă la mijloc, după ce hora mare a strâns lumea și înainte de partea târzie. Restul serii se sprijină pe hore prinse de mână, în cerc strâns, care pornesc de la tempouri mai iuți decât cele muntenești — acolo intră toată lumea, indiferent de cât știe.</p>\n\n<p class=\"mt-8\"><a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex flex-wrap items-center gap-2 min-h-[44px]\" href=\"/repertoriu/\">Vezi repertoriul complet</a></p>\n</div></div>"}, "elements": []}], "isInner": false}, {"id": "zmeh01c", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "0", "right": "24", "bottom": "0", "left": "24", "isLinked": false}}, "elements": [{"id": "zmeh01b", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"zona-divider\"></div>"}, "elements": []}], "isInner": false}, {"id": "zmeh022", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}}, "elements": [{"id": "zmeh020", "elType": "container", "settings": {"container_type": "flex", "content_width": "full", "flex_direction": "column", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "width": {"unit": "px", "size": 768, "sizes": []}, "width_mobile": {"unit": "%", "size": 100, "sizes": []}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "48", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "48", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "32", "left": "0", "isLinked": false}, "custom_css": "selector{max-width:100%}"}, "elements": [{"id": "zmeh01d", "elType": "widget", "widgetType": "heading", "settings": {"title": "Logistică", "header_size": "div", "title_color": "#C6C6C6", "typography_typography": "custom", "typography_font_family": "Inter", "typography_font_size": {"unit": "px", "size": 14, "sizes": []}, "typography_font_weight": "600", "typography_text_transform": "uppercase", "typography_letter_spacing": {"unit": "em", "size": 0.2, "sizes": []}, "typography_line_height": {"unit": "px", "size": 20, "sizes": []}, "__globals__": {"title_color": "globals/colors?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}}, "elements": []}, {"id": "zmeh01e", "elType": "widget", "widgetType": "heading", "settings": {"title": "O singură axă, dar lungă", "header_size": "h2", "title_color": "#E5E2E1", "__globals__": {"title_color": "globals/colors?id=primary", "typography_typography": "globals/typography?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_element_id": "logistica-titlu"}, "elements": []}, {"id": "zmeh01f", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Un eveniment în Mehedinți se planifică pe distanță, nu pe complexitate: drumul e continuu pe DN6, fără trecători și fără schimbări de ritm. Ce cere atenție e lungimea lui și ora la care se ajunge. Fiecare kilometru parcurs, dus și întors, se tarifează cu 6 lei.</p>", "text_color": "#C6C6C6", "custom_css": "selector p{margin:0}", "__globals__": {"text_color": "globals/colors?id=secondary", "typography_typography": "globals/typography?id=text"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": []}], "isInner": true}, {"id": "zmeh021", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><div class=\"grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-gutter max-w-4xl\">\n<div class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Distanță</span>\n<p class=\"font-display-lg text-3xl md:text-4xl text-on-surface\">~340 km din București</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Valoarea se preia din aceeași măsurătoare ca la celelalte județe. Fără cifră, singurul lucru corect de spus e că Mehedințiul e cel mai îndepărtat județ din tot setul pe care îl acoperim.</p>\n</div>\n<div class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Deplasare</span>\n<p class=\"font-headline-md text-xl md:text-headline-md text-on-surface\">Plecare cu o zi înainte, dacă e cazul</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Echipamentul greu — schelă, lumini, sonorizare — face drumul separat, înaintea echipei artistice, care pleacă abia când scena e gata. La distanța asta, pentru un eveniment de după-amiază, plecarea echipei tehnice se poate muta cu o zi înainte.</p>\n</div>\n<div class=\"glass-card silver-border p-6 md:p-8 md:col-span-2 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Cazare</span>\n<p class=\"font-headline-md text-xl md:text-headline-md text-on-surface\">Face parte din discuție de la început</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">La un program care se încheie noaptea, echipa rămâne pe loc. Modul concret în care se acoperă cazarea se lămurește la discuția de organizare, împreună cu ora de final. <span class=\"ph\">[CAZARE MEHEDINȚI — de confirmat]</span></p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Nu există variantă de eveniment în Mehedinți în care capitolul să nu apară deloc — e singura pagină din set unde spunem asta fără rezerve.</p>\n</div>\n</div></div>"}, "elements": []}], "isInner": false}, {"id": "zmeh024", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "0", "right": "24", "bottom": "0", "left": "24", "isLinked": false}}, "elements": [{"id": "zmeh023", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"zona-divider\"></div>"}, "elements": []}], "isInner": false}, {"id": "zmeh026", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}}, "elements": [{"id": "zmeh025", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><div class=\"max-w-3xl mx-auto glass-card silver-border p-6 md:p-12 text-center flex flex-col items-center gap-5\">\n<span class=\"font-label-md text-label-md text-primary uppercase tracking-[0.2em]\">Pachete</span>\n<h2 class=\"font-headline-lg text-2xl md:text-headline-lg leading-tight\" id=\"pachete-titlu\">Două rânduri peste pachet, amândouă previzibile</h2>\n<p class=\"font-body-lg text-base md:text-body-lg text-on-surface-variant\">Configurațiile nu diferă de la un județ la altul. Pentru Mehedinți, oferta finală are pachetul ales, transportul calculat pe traseul real și cazarea, fiecare pe rândul lui — și niciuna dintre cele două linii suplimentare nu apare ca surpriză la final.</p>\n\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Programul se pliază pe eveniment: <a class=\"text-primary underline underline-offset-4 hover:text-white transition-colors\" href=\"/nunta/\">nunta</a>, <a class=\"text-primary underline underline-offset-4 hover:text-white transition-colors\" href=\"/botez/\">botezul</a> și <a class=\"text-primary underline underline-offset-4 hover:text-white transition-colors\" href=\"/eveniment-privat/\">petrecerea de familie</a> au fiecare alt tipar. Separat de ele stă <a class=\"text-primary underline underline-offset-4 hover:text-white transition-colors\" href=\"/corporate/\">seara de firmă</a>.</p>\n<div class=\"motif-rule max-w-[180px] w-full\"><span class=\"motif-rule__gem zona-gem\"></span></div>\n<div class=\"flex flex-col sm:flex-row gap-4 w-full sm:w-auto\">\n<a class=\"inline-block text-center whitespace-nowrap bg-accent text-white px-8 md:px-10 py-4 uppercase font-label-md text-label-md tracking-widest hover:bg-accent-hover transition-colors w-full sm:w-auto\" href=\"/oferte/\">Vezi toate pachetele</a>\n<a class=\"btn-secundar-zona inline-block text-center whitespace-nowrap text-on-surface bg-transparent px-8 md:px-10 py-4 uppercase font-label-md text-label-md tracking-widest hover:bg-white/5 transition-colors w-full sm:w-auto\" href=\"/contact/\">Cere ofertă</a>\n</div>\n</div></div>"}, "elements": []}], "isInner": false}, {"id": "zmeh028", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "0", "right": "24", "bottom": "0", "left": "24", "isLinked": false}}, "elements": [{"id": "zmeh027", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"zona-divider\"></div>"}, "elements": []}], "isInner": false}, {"id": "zmeh033", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}}, "elements": [{"id": "zmeh02b", "elType": "container", "settings": {"container_type": "flex", "content_width": "full", "flex_direction": "column", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "width": {"unit": "px", "size": 768, "sizes": []}, "width_mobile": {"unit": "%", "size": 100, "sizes": []}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "48", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "48", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "32", "left": "0", "isLinked": false}, "custom_css": "selector{max-width:100%}"}, "elements": [{"id": "zmeh029", "elType": "widget", "widgetType": "heading", "settings": {"title": "Întrebări", "header_size": "div", "title_color": "#C6C6C6", "typography_typography": "custom", "typography_font_family": "Inter", "typography_font_size": {"unit": "px", "size": 14, "sizes": []}, "typography_font_weight": "600", "typography_text_transform": "uppercase", "typography_letter_spacing": {"unit": "em", "size": 0.2, "sizes": []}, "typography_line_height": {"unit": "px", "size": 20, "sizes": []}, "__globals__": {"title_color": "globals/colors?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}}, "elements": []}, {"id": "zmeh02a", "elType": "widget", "widgetType": "heading", "settings": {"title": "Distanța, figurile de joc și vremea", "header_size": "h2", "title_color": "#E5E2E1", "__globals__": {"title_color": "globals/colors?id=primary", "typography_typography": "globals/typography?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "_element_id": "faq-titlu"}, "elements": []}], "isInner": true}, {"id": "zmeh031", "elType": "container", "settings": {"container_type": "flex", "content_width": "full", "flex_direction": "column", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "width": {"unit": "px", "size": 768, "sizes": []}, "width_mobile": {"unit": "%", "size": 100, "sizes": []}, "custom_css": "selector{max-width:100%}", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": [{"id": "zmeh02c", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"faq-item\"><details open><summary aria-expanded=\"true\"><h3>Sunteți din București. Nu e prea departe ca să veniți până la Severin?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 -960 960 960\" fill=\"currentColor\"><path d=\"M480-357.85 253.85-584l32.61-32.61L480-423.08l193.54-193.53L706.15-584 480-357.85Z\"/></svg></summary><div class=\"faq-item__answer\"><p>Nu, dar se planifică altfel decât un eveniment la 100 km. Drumul se face cu o zi rezervă pentru echipamentul greu, iar echipa rămâne peste noapte.</p>\n<p>Ce trebuie știut din timp e ora de începere. Ea decide dacă plecarea se face în dimineața evenimentului sau cu o zi înainte.</p></div></details></div>", "custom_css": "selector{margin-bottom:16px}selector h3{margin:0;padding-right:16px;font-family:\"EB Garamond\",Georgia,serif;font-size:16px;font-weight:500;line-height:1.375;color:var(--e-global-color-primary)}@media(min-width:768px){selector h3{font-size:24px}}selector .faq-item__answer{font-family:Inter,sans-serif;font-size:16px;line-height:1.6}selector .faq-item__answer p{margin:0}selector .faq-item__answer p+p{margin-top:12px}"}, "elements": []}, {"id": "zmeh02d", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"faq-item\"><details><summary aria-expanded=\"false\"><h3>Vrem și jocuri cu figuri, din alea cu bătăi din călcâi. Se cântă?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 -960 960 960\" fill=\"currentColor\"><path d=\"M480-357.85 253.85-584l32.61-32.61L480-423.08l193.54-193.53L706.15-584 480-357.85Z\"/></svg></summary><div class=\"faq-item__answer\"><p>Da, fac parte din repertoriul oltenesc: sârbele și brâulețele au figuri de virtuozitate pentru bărbați, cu sărituri, pinteni și lovituri din călcâi.</p>\n<p>Momentul se pune la mijlocul serii, nu la început. Se face loc pe ring, iar cei care știu intră; restul privește, și e bine așa — e singurul bloc din seară care nu se joacă de toată lumea.</p></div></details></div>", "custom_css": "selector{margin-bottom:16px}selector h3{margin:0;padding-right:16px;font-family:\"EB Garamond\",Georgia,serif;font-size:16px;font-weight:500;line-height:1.375;color:var(--e-global-color-primary)}@media(min-width:768px){selector h3{font-size:24px}}selector .faq-item__answer{font-family:Inter,sans-serif;font-size:16px;line-height:1.6}selector .faq-item__answer p{margin:0}selector .faq-item__answer p+p{margin-top:12px}"}, "elements": []}, {"id": "zmeh02e", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"faq-item\"><details><summary aria-expanded=\"false\"><h3>Petrecerea e la Orșova, pe malul Dunării. Contează că e în defileu?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 -960 960 960\" fill=\"currentColor\"><path d=\"M480-357.85 253.85-584l32.61-32.61L480-423.08l193.54-193.53L706.15-584 480-357.85Z\"/></svg></summary><div class=\"faq-item__answer\"><p>Pentru muzică, nu. Pentru drum, da: după Drobeta șoseaua urmează fluviul, iar timpul de parcurs nu mai e proporțional cu kilometrii.</p>\n<p>Ne spuneți adresa exactă a locației și calculăm traseul real. Suplimentul de transport rămâne la 6 lei/km, dus-întors, pe kilometrii efectivi.</p></div></details></div>", "custom_css": "selector{margin-bottom:16px}selector h3{margin:0;padding-right:16px;font-family:\"EB Garamond\",Georgia,serif;font-size:16px;font-weight:500;line-height:1.375;color:var(--e-global-color-primary)}@media(min-width:768px){selector h3{font-size:24px}}selector .faq-item__answer{font-family:Inter,sans-serif;font-size:16px;line-height:1.6}selector .faq-item__answer p{margin:0}selector .faq-item__answer p+p{margin-top:12px}"}, "elements": []}, {"id": "zmeh02f", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"faq-item\"><details><summary aria-expanded=\"false\"><h3>O parte dintre invitați vin de peste Dunăre, din Serbia. Se schimbă ceva la program?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 -960 960 960\" fill=\"currentColor\"><path d=\"M480-357.85 253.85-584l32.61-32.61L480-423.08l193.54-193.53L706.15-584 480-357.85Z\"/></svg></summary><div class=\"faq-item__answer\"><p>Ce ne ajută e să știm din timp câți sunt și ce își doresc să audă. Programul se construiește pe lista de invitați, iar un grup mare dintr-o singură direcție schimbă proporțiile.</p>\n<p>Ce anume intră concret în program pentru ei se stabilește la discuția de organizare: <span class=\"ph\">[REPERTORIU PENTRU INVITAȚI DIN SERBIA — de confirmat]</span></p></div></details></div>", "custom_css": "selector{margin-bottom:16px}selector h3{margin:0;padding-right:16px;font-family:\"EB Garamond\",Georgia,serif;font-size:16px;font-weight:500;line-height:1.375;color:var(--e-global-color-primary)}@media(min-width:768px){selector h3{font-size:24px}}selector .faq-item__answer{font-family:Inter,sans-serif;font-size:16px;line-height:1.6}selector .faq-item__answer p{margin:0}selector .faq-item__answer p+p{margin-top:12px}"}, "elements": []}, {"id": "zmeh030", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"faq-item\"><details><summary aria-expanded=\"false\"><h3>Dacă se strică vremea și drumul e blocat, ce se întâmplă?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 -960 960 960\" fill=\"currentColor\"><path d=\"M480-357.85 253.85-584l32.61-32.61L480-423.08l193.54-193.53L706.15-584 480-357.85Z\"/></svg></summary><div class=\"faq-item__answer\"><p>De asta echipamentul pleacă separat și devreme. Marja de timp e construită tocmai pentru situațiile în care DN6 merge mai greu decât de obicei.</p>\n<p>Pentru evenimentele de iarnă, plecarea se mută cu o zi înainte ca regulă, nu ca excepție.</p></div></details></div>", "custom_css": "selector{margin-bottom:16px}selector h3{margin:0;padding-right:16px;font-family:\"EB Garamond\",Georgia,serif;font-size:16px;font-weight:500;line-height:1.375;color:var(--e-global-color-primary)}@media(min-width:768px){selector h3{font-size:24px}}selector .faq-item__answer{font-family:Inter,sans-serif;font-size:16px;line-height:1.6}selector .faq-item__answer p{margin:0}selector .faq-item__answer p+p{margin-top:12px}"}, "elements": []}], "isInner": true}, {"id": "zmeh032", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><div class=\"mt-10 md:mt-12\">\n<a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex items-center gap-2 min-h-[44px]\" href=\"/faq/\">Vezi toate întrebările frecvente <svg aria-hidden=\"true\" class=\"text-[18px]\" fill=\"currentColor\" height=\"1em\" style=\"vertical-align:-.125em\" viewbox=\"0 -960 960 960\" width=\"1em\"><path d=\"M693.69-457.31H180v-45.38h513.69L448.39-748 480-780l300 300-300 300-31.61-32 245.3-245.31Z\"></path></svg></a>\n</div></div>"}, "elements": []}], "isInner": false}, {"id": "zmeh037", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 544, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "flex_align_items": "center", "background_background": "classic", "background_color": "#1C1B1B", "__globals__": {"background_color": "globals/colors?id=surfacealt"}, "custom_css": "selector{background-color:#1C1B1B}s