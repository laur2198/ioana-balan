margin": {"unit": "px", "top": "0", "right": "0", "bottom": "48", "left": "0", "isLinked": false}, "margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "48", "left": "0", "isLinked": false}, "margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "32", "left": "0", "isLinked": false}, "custom_css": "selector{max-width:100%}"}, "elements": [{"id": "zcal00a", "elType": "widget", "widgetType": "heading", "settings": {"title": "Acoperire", "header_size": "div", "title_color": "#C6C6C6", "typography_typography": "custom", "typography_font_family": "Inter", "typography_font_size": {"unit": "px", "size": 14, "sizes": []}, "typography_font_weight": "600", "typography_text_transform": "uppercase", "typography_letter_spacing": {"unit": "em", "size": 0.2, "sizes": []}, "typography_line_height": {"unit": "px", "size": 20, "sizes": []}, "__globals__": {"title_color": "globals/colors?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}}, "elements": []}, {"id": "zcal00b", "elType": "widget", "widgetType": "heading", "settings": {"title": "Între Oltenița și brațul Borcea", "header_size": "h2", "title_color": "#E5E2E1", "__globals__": {"title_color": "globals/colors?id=primary", "typography_typography": "globals/typography?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_element_id": "localitati-titlu"}, "elements": []}, {"id": "zcal00c", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Oltenița, Budești și Fundulea sunt în vestul județului, cele mai apropiate de București. Lehliu-Gară și Dragalina sunt pe drumul spre est, iar orașul Călărași, Cuza Vodă și Borcea se află spre Dunăre și spre brațul Borcea, la capătul îndepărtat.</p>", "text_color": "#C6C6C6", "custom_css": "selector p{margin:0}", "__globals__": {"text_color": "globals/colors?id=secondary", "typography_typography": "globals/typography?id=quote"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": []}], "isInner": true}, {"id": "zcal00e", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><div class=\"glass-card silver-border p-6 md:p-10 max-w-4xl\">\n<ul class=\"motif-list grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-4\">\n<li class=\"font-body-lg text-base md:text-body-lg\">Călărași</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Oltenița</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Lehliu-Gară</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Budești</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Fundulea</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Dragalina</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Borcea</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Cuza Vodă</li>\n</ul>\n<div class=\"motif-rule max-w-[180px] w-full mt-8\"><span class=\"motif-rule__gem zona-gem\"></span></div>\n<p class=\"font-body-md text-body-md text-on-surface-variant mt-6\">Oltenița e mult mai aproape de București decât orașul Călărași, și se ajunge la ele pe drumuri diferite. De aceea distanța se calculează pe axa localității dumneavoastră, nu pe „județul Călărași” în general.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant mt-6\">Pe axa lungă, în orașul Călărași, am cântat la Hestia Park Lounge.</p>\n</div></div>"}, "elements": []}, {"id": "zcal00f", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>De la Chiciu, lângă oraș, platformele de bac trec Dunărea la Ostrov, în <a href=\"/zone/constanta/\">Constanța</a>, în mai puțin de un sfert de oră, când vremea și nivelul apei o permit. Pe uscat, DN21 urcă prin Dragalina până la Slobozia, în <a href=\"/zone/ialomita/\">Ialomița</a>. Iar Oltenița e locul unde se termină Argeșul, după ce a străbătut <a href=\"/zone/giurgiu/\">Giurgiu</a>.</p>", "text_color": "#C6C6C6", "custom_css": "selector p{margin:0}selector{max-width:768px !important}", "__globals__": {"text_color": "globals/colors?id=secondary", "typography_typography": "globals/typography?id=text"}, "_margin": {"unit": "px", "top": "32", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "32", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "32", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": []}, {"id": "zcal010", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><p class=\"mt-8\"><a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex flex-wrap items-center gap-2 min-h-[44px]\" href=\"/zone/\">Toate zonele deservite</a></p></div>"}, "elements": []}], "isInner": false}, {"id": "zcal013", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "0", "right": "64