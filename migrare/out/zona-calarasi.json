graphy_font_weight": "600", "typography_text_transform": "uppercase", "typography_letter_spacing": {"unit": "em", "size": 0.2, "sizes": []}, "typography_line_height": {"unit": "px", "size": 20, "sizes": []}, "__globals__": {"title_color": "globals/colors?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}}, "elements": []}, {"id": "zcal015", "elType": "widget", "widgetType": "heading", "settings": {"title": "Bărăgan și Dunăre: muzica unei câmpii deschise", "header_size": "h2", "title_color": "#E5E2E1", "__globals__": {"title_color": "globals/colors?id=primary", "typography_typography": "globals/typography?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "24", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "24", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "24", "left": "0", "isLinked": false}, "_element_id": "repertoriu-titlu"}, "elements": []}, {"id": "zcal016", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Călărașiul ține de Muntenia de câmpie, în partea ei cea mai larg deschisă: sudul Bărăganului și lunca Dunării. Aici se cer hora și sârba de Bărăgan, jucate în cercuri mari, care se umplu repede și rămân pline. Fondul e comun cu al Ialomiței vecine; ce se adaugă e fluviul și, pe malul celălalt, Dobrogea.</p>", "text_color": "#C6C6C6", "custom_css": "selector p{margin:0}", "__globals__": {"text_color": "globals/colors?id=secondary", "typography_typography": "globals/typography?id=quote"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": []}, {"id": "zcal017", "elType": "widget", "widgetType": "heading", "settings": {"title": "Ce aduce vecinătatea cu Dobrogea", "header_size": "h3", "title_color": "#E5E2E1", "__globals__": {"title_color": "globals/colors?id=primary", "typography_typography": "globals/typography?id=lead"}, "_margin": {"unit": "px", "top": "36", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "36", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "36", "right": "0", "bottom": "16", "left": "0", "isLinked": false}}, "elements": []}, {"id": "zcal018", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Între Chiciu, lângă orașul Călărași, și Ostrov circulă bacul peste Dunăre, iar legăturile dintre cele două maluri sunt vechi. La o nuntă din estul județului se poate întâmpla ca printre invitați să fie familii dobrogene, care recunosc o geamparale sau un joc aromânesc. Programul nu se construiește în jurul lor, dar un moment scurt pentru ele se pregătește ușor, dacă aflăm de la început.</p>", "text_color": "#C6C6C6", "custom_css": "selector p{margin:0}", "__globals__": {"text_color": "globals/colors?id=secondary", "typography_typography": "globals/typography?id=quote"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": []}, {"id": "zcal019", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><p class=\"mt-8\"><a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex flex-wrap items-center gap-2 min-h-[44px]\" href=\"/repertoriu/\">Vezi repertoriul complet</a></p></div>"}, "elements": []}], "isInner": true}], "isInner": false}, {"id": "zcal01d", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "0", "right": "24", "bottom": "0", "left": "24", "isLinked": false}}, "elements": [{"id": "zcal01c", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"zona-divider\"></div>"}, "elements": []}], "isInner": false}, {"id": "zcal023", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}}, "elements": [{"id": "zcal021", "elType": "container", "settings": {"container_type": "flex", "content_width": "full", "flex_direction": "column", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "width": {"unit": "px", "size": 768, "sizes": []}, "width_mobile": {"unit": "%", "size": 100, "sizes": []}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "48", "left": "0", "isLinked": false}, "margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "48", "left": "0", "isLinked": false}, "margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "32", "left": "0", "isLinked": false}, "custom_css": "selector{max-width:100%}"}, "elements": [{"id": "zcal01e", "elType": "widget", "widgetType": "heading", "settings": {"title": "Logistică", "header_size": "div", "title_color": "#C6C6C6", "typography_typography": "custom", "typography_font_family": "Inter", "typography_font_size": {"unit": "px", "size": 14, "sizes": []}, "typography_font_weight": "600", "typography_text_transform": "uppercase", "typography_letter_spacing": {"unit": "em", "size": 0.2, "sizes": []}, "typography_line_height": {"unit": "px", "size": 20, "sizes": []}, "__globals__": {"title_color": "globals/colors?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}}, "elements": []}, {"id": "zcal01f", "elType": "widget", "widgetType": "heading", "settings": {"title": "Două axe, două calcule", "header_size": "h2", "title_color": "#E5E2E1", "__globals__": {"title_color": "globals/colors?id=primary", "typography_typography": "globals/typography?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_element_id": "logistica-titlu"}, "elements": []}, {"id": "zcal020", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Pentru Călărași nu se poate da o singură distanță: Fundulea și Oltenița sunt aproape de București, orașul Călărași e la peste o sută de kilometri. Calculul pornește de la localitate — kilometrii dus-întors, la 6 lei fiecare —, iar întrebarea despre cazare apare numai la capătul dinspre Dunăre.</p>", "text_color": "#C6C6C6", "custom_css": "selector p{margin:0}", "__globals__": {"text_color": "globals/colors?id=secondary", "typography_typography": "globals/typography?id=text"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": []}], "isInner": true}, {"id": "zcal022", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><div class=\"grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-gutter max-w-4xl\">\n<div class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Distanță</span>\n<p class=\"font-display-lg text-3xl md:text-4xl text-on-surface\">~110 km</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Până în orașul Călărași, pe A2 sau pe DN3. Oltenița, pe DN4, e mult mai aproape, iar Lehliu-Gară se află cam la jumătatea drumului spre reședința de județ.</p>\n</div>\n<div class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Deplasare</span>\n<p class=\"font-headline-md text-xl md:text-headline-md text-on-surface\">Autostradă spre est, drum național spre sud</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Pe A2 transportul echipamentului e rapid și previzibil până la ieșirea spre Lehliu; restul se face pe drum național, prin câmpie. Spre Oltenița nu există autostradă, dar nici distanța nu o cere.</p>\n</div>\n<div class=\"glass-card silver-border p-6 md:p-8 md:col-span-2 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Cazare</span>\n<p class=\"font-headline-md text-xl md:text-headline-md text-on-surface\">Doar la capătul de est, și doar la final târziu</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Pentru Oltenița, Budești sau Fundulea, întoarcerea în aceeași noapte nu ridică nicio întrebare. Pentru Călărași, Cuza Vodă sau Borcea, dacă petrecerea se încheie spre dimineață, stabilim la organizare dacă drumul înapoi se face imediat după demontare sau a doua zi.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Dacă echipa rămâne, felul în care se rezolvă noaptea de hotel intră în aceeași discuție, alături de ce preferă mirii.</p>\n</div>\n</div></div>"}, "elements": []}], "isInner": false}, {"id": "zcal025", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "0", "right": "24", "bottom": "0", "left": "24", "isLinked": false}}, "elements": [{"id": "zcal024", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"zona-divider\"></div>"}, "elements": []}], "isInner": false}, {"id": "zcal027", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}}, "elements": [{"id": "zcal026", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><div class=\"max-w-3xl mx-auto glass-card silver-border p-6 md:p-12 text-center flex flex-col items-center gap-5\">\n<span class=\"font-label-md text-label-md text-primary uppercase tracking-[0.2em]\">Pachete</span>\n<h2 class=\"font-headline-lg text-2xl md:text-headline-lg leading-tight\" id=\"pachete-titlu\">Același pachet, pe două distanțe posibile</h2>\n<p class=\"font-body-lg text-base md:text-body-lg text-on-surface-variant\">În județul Călărași configurația aleasă nu se schimbă, dar prețul final ține cont de axa pe care e locația. O nuntă la Oltenița primește un supliment de transport mic; una lângă Borcea, unul mai mare și, la un program lung, o discuție despre cazare.</p>\n\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Pe axa Olteniței sau pe cea dinspre Borcea, o <a class=\"text-primary underline underline-offset-4 hover:text-white transition-colors\" href=\"/nunta/\">nuntă</a>, un <a class=\"text-primary underline underline-offset-4 hover:text-white transition-colors\" href=\"/botez/\">botez</a> și o <a class=\"text-primary underline underline-offset-4 hover:text-white transition-colors\" href=\"/eveniment-privat/\">aniversare</a> se calculează la fel ca distanță, dar nu și ca program. Iar dacă locația găzduiește o <a class=\"text-primary underline underline-offset-4 hover:text-white transition-colors\" href=\"/corporate/\">gală a firmei</a>, pagina ei explică ce se schimbă față de o petrecere privată.</p>\n<div class=\"motif-rule max-w-[180px] w-full\"><span class=\"motif-rule__gem zona-gem\"></span></div>\n<div class=\"flex flex-col sm:flex-row gap-4 w-full sm:w-auto\">\n<a class=\"inline-block text-center whitespace-nowrap bg-accent text-white px-8 md:px-10 py-4 uppercase font-label-md text-label-md tracking-widest hover:bg-accent-hover transition-colors w-full sm:w-auto\" href=\"/oferte/\">Vezi toate pachetele</a>\n<a class=\"btn-secundar-zona inline-block text-center whitespace-nowrap text-on-surface bg-transparent px-8 md:px-10 py-4 uppercase font-label-md text-label-md tracking-widest hover:bg-white/5 transition-colors w-full sm:w-auto\" href=\"/contact/\">Cere ofertă</a>\n</div>\n</div></div>"}, "elements": []}], "isInner": false}, {"id": "zcal029", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "0", "right": "24", "bottom": "0", "left": "24", "isLinked": false}}, "elements": [{"id": "zcal028", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"zona-divider\"></div>"}, "elements": []}], "isInner": false}, {"id": "zcal034", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 