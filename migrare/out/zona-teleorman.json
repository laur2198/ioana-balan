{"meta": {"src": "zona-teleorman.html", "slug": "teleorman", "parent": "zone", "noindex": false, "seo_title": "Jocuri de Câmpie și Folclor în Teleorman | Nunți, Botezuri în Alexandria | Ioana Balan", "metadesc": "Hore și sârbe de câmpie live la nunți și botezuri în Alexandria și în tot Teleormanul, până la Dunăre: repertoriu muntenesc, cu jocuri oltenești la cerere.", "jsonld": [{"@context": "https://schema.org", "@type": "Service", "name": "Jocuri de câmpie și folclor live pentru evenimente în Alexandria și județul Teleorman", "serviceType": "Muzică live pentru nuntă, botez și eveniment corporate", "description": "Hore, sârbe și jocuri de câmpie live pentru nunți, botezuri și evenimente corporate în Alexandria și în județul Teleorman, până la Dunăre, cu repertoriu muntenesc, jocuri oltenești la cerere și sonorizare proprie.", "areaServed": [{"@type": "City", "name": "Alexandria"}, {"@type": "AdministrativeArea", "name": "Județul Teleorman"}], "provider": {"@type": "MusicGroup", "@id": "https://ioana-balan.ro/#artist", "name": "Ioana Balan", "url": "https://ioana-balan.ro/", "genre": ["Muzică populară", "Muzică de petrecere", "Folclor"], "foundingLocation": {"@type": "Place", "name": "București, România"}, "telephone": "+40722911485", "email": "ioanabalanoficial@gmail.com", "sameAs": ["https://www.facebook.com/ioanabalanoficial", "https://www.instagram.com/ioanabalanoficial/", "https://www.tiktok.com/@ioanabalanmusic", "https://www.youtube.com/channel/UCNTWODu5imMryMhkbbw6vEQ", "https://ro.pinterest.com/ioanabalanoficial/"]}, "availableChannel": {"@type": "ServiceChannel", "servicePhone": {"@type": "ContactPoint", "telephone": "+40722911485", "contactType": "rezervări"}, "serviceUrl": "https://wa.me/40722911485"}}], "h1": "Jocuri de câmpie cu tempo apăsat, pentru nunți și botezuri în Teleorman", "title": "Teleorman"}, "elements": [{"id": "ztel009", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "