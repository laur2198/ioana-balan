x", "top": "0", "right": "0", "bottom": "32", "left": "0", "isLinked": false}, "custom_css": "selector{max-width:100%}"}, "elements": [{"id": "ztel00a", "elType": "widget", "widgetType": "heading", "settings": {"title": "Acoperire", "header_size": "div", "title_color": "#C6C6C6", "typography_typography": "custom", "typography_font_family": "Inter", "typography_font_size": {"unit": "px", "size": 14, "sizes": []}, "typography_font_weight": "600", "typography_text_transform": "uppercase", "typography_letter_spacing": {"unit": "em", "size": 0.2, "sizes": []}, "typography_line_height": {"unit": "px", "size": 20, "sizes": []}, "__globals__": {"title_color": "globals/colors?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}}, "elements": []}, {"id": "ztel00b", "elType": "widget", "widgetType": "heading", "settings": {"title": "Opt localități, pe drumurile care pleacă din Alexandria", "header_size": "h2", "title_color": "#E5E2E1", "__globals__": {"title_color": "globals/colors?id=primary", "typography_typography": "globals/typography?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_element_id": "localitati-titlu"}, "elements": []}, {"id": "ztel00c", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Alexandria e nodul din care se ramifică județul: spre nord-vest către Roșiorii de Vede, spre sud-vest către Turnu Măgurele, spre sud către Zimnicea. Videle și Drăgănești-Vlașca sunt pe partea dinspre București, deci cele mai apropiate, iar Nanov și Poroschia sunt practic lipite de reședința de județ.</p>", "text_color": "#C6C6C6", "custom_css": "selector p{margin:0}", "__globals__": {"text_color": "globals/colors?id=secondary", "typography_typography": "globals/typography?id=quote"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": []}], "isInner": true}, {"id": "ztel00e", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><div class=\"glass-card silver-border p-6 md:p-10 max-w-4xl\">\n<ul class=\"motif-list grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-4\">\n<li class=\"font-body-lg text-base md:text-body-lg\">Alexandria</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Roșiorii de Vede</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Turnu Măgurele</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Zimnicea</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Videle</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Nanov</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Poroschia</li>\n<li class=\"font-body-lg text-base md:text-body-lg\">Drăgănești-Vlașca</li>\n</ul>\n<div class=\"motif-rule max-w-[180px] w-full mt-8\"><span class=\"motif-rule__gem zona-gem\"></span></div>\n<p class=\"font-body-md text-body-md text-on-surface-variant mt-6\">Drăgănești-Vlașca păstrează în nume vechiul județ Vlașca, desființat la reorganizarea din 1950 — granițele administrative s-au mutat mai des decât jocurile. Pentru o comună care lipsește de aici, contează de care parte a Alexandriei se află: spre nord-est e mai aproape de București decât reședința, spre Dunăre e mai departe.</p>\n</div></div>"}, "elements": []}, {"id": "ztel00f", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Vedea, râul pe care stau Roșiorii de Vede și Alexandria, izvorăște în <a href=\"/zone/arges/\">Argeș</a>, pe Podișul Cotmeana. DN6 taie județul pe orizontală: vine dinspre Ghimpați, din <a href=\"/zone/giurgiu/\">Giurgiu</a>, trece prin Drăgănești-Vlașca și Alexandria și pleacă mai departe, pe la Caracal, spre Craiova, în <a href=\"/zone/dolj/\">Dolj</a>.</p>", "text_color": "#C6C6C6", "custom_css": "selector p{margin:0}selector{max-width:768px !important}", "__globals__": {"text_color": "globals/colors?id=secondary", "typography_typography": "globals/typography?id=text"}, "_margin": {"unit": "px", "top": "32", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "32", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "32", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": []}, {"id": "ztel010", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><p class=\"mt-8\"><a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex flex-wrap items-center gap-2 min-h-[44px]\" href=\"/zone/\">Toate zonele deservite</a></p></div>"}, "elements": []}], "isInner": false}, {"id": "ztel013", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "0", "right": "24", "bottom": "0", "left": "24", "isLinked": false}}, "elements": [{"id": "ztel01