"0", "right": "0", "bottom": "48", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "32", "left": "0", "isLinked": false}, "custom_css": "selector{max-width:100%}"}, "elements": [{"id": "even022", "elType": "widget", "widgetType": "heading", "settings": {"title": "Întrebări", "header_size": "div", "title_color": "#C6C6C6", "typography_typography": "custom", "typography_font_family": "Inter", "typography_font_size": {"unit": "px", "size": 14, "sizes": []}, "typography_font_weight": "600", "typography_text_transform": "uppercase", "typography_letter_spacing": {"unit": "em", "size": 0.2, "sizes": []}, "typography_line_height": {"unit": "px", "size": 20, "sizes": []}, "__globals__": {"title_color": "globals/colors?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}}, "elements": []}, {"id": "even023", "elType": "widget", "widgetType": "heading", "settings": {"title": "Întrebări despre muzica la o petrecere de familie", "header_size": "h2", "title_color": "#E5E2E1", "__globals__": {"title_color": "globals/colors?id=primary", "typography_typography": "globals/typography?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "_element_id": "faq-titlu"}, "elements": []}], "isInner": true}, {"id": "even029", "elType": "container", "settings": {"container_type": "flex", "content_width": "full", "flex_direction": "column", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "width": {"unit": "px", "size": 768, "sizes": []}, "width_mobile": {"unit": "%", "size": 100, "sizes": []}, "custom_css": "selector{max-width:100%}", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": [{"id": "even025", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"faq-item\"><details open><summary aria-expanded=\"true\"><h3>Poate fi seara doar cu muzică de ascultare, fără petrecere?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 -960 960 960\" fill=\"currentColor\"><path d=\"M480-357.85 253.85-584l32.61-32.61L480-423.08l193.54-193.53L706.15-584 480-357.85Z\"/></svg></summary><div class=\"faq-item__answer\"><p>Da, e o formă de program la fel de legitimă ca petrecerea. Se construiește pe cântec ușor, romanțe și melodii de masă, la un volum de conversație, iar configurația se alege pe măsura ei.</p></div></details></div>", "custom_css": "selector{margin-bottom:16px}selector h3{margin:0;padding-right:16px;font-family:\"EB Garamond\",Georgia,serif;font-size:16px;font-weight:500;line-height:1.375;color:var(--e-global-color-primary)}@media(min-width:768px){selector h3{font-size:24px}}selector .faq-item__answer{font-family:Inter,sans-serif;font-size:16px;line-height:1.6}selector .faq-item__answer p{margin:0}selector .faq-item__answer p+p{margin-top:12px}"}, "elements": []}, {"id": "even026", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"faq-item\"><details><summary aria-expanded=\"false\"><h3>Cât durează programul la o aniversare?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 -960 960 960\" fill=\"currentColor\"><path d=\"M480-357.85 253.85-584l32.61-32.61L480-423.08l193.54-193.53L706.15-584 480-357.85Z\"/></svg></summary><div class=\"faq-item__answer\"><p>Nu există o durată standard, ca la nuntă. Se stabilește pornind de la ora de început și de la cât din seară e petrecere. Durata minimă pentru care se face deplasarea: <span class=\"ph\">[DURATĂ MINIMĂ LA EVENIMENT PRIVAT — de confirmat]</span>.</p></div></details></div>", "custom_css": "selector{margin-bottom:16px}selector h3{margin:0;padding-right:16px;font-family:\"EB Garamond\",Georgia,serif;font-size:16px;font-weight:500;line-height:1.375;color:var(--e-global-color-primary)}@media(min-width:768px){selector h3{font-size:24px}}selector .faq-item__answer{font-family:Inter,sans-serif;font-size:16px;line-height:1.6}selector .faq-item__answer p{margin:0}selector .faq-item__answer p+p{margin-top:12px}"}, "elements": []}, {"id": "even027", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"faq-item\"><details><summary aria-expanded=\"false\"><h3>Se poate organiza petrecerea acasă sau în curte?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 -960 960 960\" fill=\"currentColor\"><path d=\"M480-357.85 253.85-584l32.61-32.61L480-423.08l193.54-193.53L706.15-584 480-357.85Z\"/></svg></summary><div class=\"faq-item__answer\"><p>Condițiile țin de spațiu: un loc plan și acoperit pentru formație, ferit de ploaie, și un drum pe care mașina cu echipament ajunge până aproape de el.</p>\n<p>Într-o zonă rezidențială contează și regulile locale privind liniștea publică. Ora de final se fixează ținând cont de ele, nu doar de cheful invitaților.</p></div></details></div>", "custom_css": "selector{margin-bottom:16px}selector h3{margin:0;padding-right:16px;font-family:\"EB Garamond\",Georgia,serif;font-size:16px;font-weight:500;line-height:1.375;color:var(--e-global-color-primary)}@media(min-width:768px){selector h3{font-size:24px}}selector .faq-item__answer{font-family:Inter,sans-serif;font-size:16px;line-height:1.6}selector .faq-item__answer p{margin:0}selector .faq-item__answer p+p{margin-top:12px}"}, "elements": []}, {"id": "even028", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"faq-item\"><details><summary aria-expanded=\"false\"><h3>Cu cât timp înainte se rezervă un eveniment privat?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 -960 960 960\" fill=\"currentColor\"><path d=\"M480-357.85 253.85-584l32.61-32.61L480-423.08l193.54-193.53L706.15-584 480-357.85Z\"/></svg></summary><div class=\"faq-item__answer\"><p>Depinde mai mult de zi decât de tipul evenimentului. O aniversare într-o sâmbătă din sezonul nunților concurează pentru aceeași dată cu o nuntă, deci merită rezervată la fel de devreme; o seară în timpul săptămânii sau în extrasezon se prinde, de regulă, mai ușor.</p></div></details></div>", "custom_css": "selector{margin-bottom:16px}selector h3{margin:0;padding-right:16px;font-family:\"EB Garamond\",Georgia,serif;font-size:16px;font-weight:500;line-height:1.375;color:var(--e-global-color-primary)}@media(min-width:768px){selector h3{font-size:24px}}selector .faq-item__answer{font-family:Inter,sans-serif;font-size:16px;line-height:1.6}selector .faq-item__answer p{margin:0}selector .faq-item__answer p+p{margin-top:12px}"}, "elements": []}], "isInner": true}, {"id": "even02a", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><div class=\"mt-10 md:mt-12\">\n<a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex items-center gap-2 min-h-[44px]\" href=\"/faq/\">Vezi toate întrebările frecvente <svg aria-hidden=\"true\" class=\"text-[18px]\" fill=\"currentColor\" height=\"1em\" style=\"vertical-align:-.125em\" viewbox=\"0 -960 960 960\" width=\"1em\"><path d=\"M693.69-457.31H180v-45.38h513.69L448.39-748 480-780l300 300-300 300-31.61-32 245.3-245.31Z\"></path></svg></a>\n</div></div>"}, "elements": []}], "isInner": false}, {"id": "even02f", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 544, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "flex_align_items": "center", "background_background": "classic", "background_color": "#