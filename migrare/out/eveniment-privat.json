{"meta": {"src": "eveniment-privat.html", "slug": "eveniment-privat", "parent": null, "noindex": false, "seo_title": "Muzică pentru aniversări, cumetrii și onomastici | Ioana Balan", "metadesc": "Cum se organizează muzica la o aniversare, o cumetrie sau o onomastică: configurație redusă, program flexibil și repertoriu ales după invitați și după local.", "jsonld": [{"@context": "https://schema.org", "@type": "Service", "name": "Muzică live pentru evenimente private", "serviceType": "Muzică live pentru aniversări, cumetrii, onomastici și petreceri de familie", "description": "Organizarea muzicii la evenimente private — aniversări, cumetrii, onomastici, petreceri de familie —, cu configurație redusă, program flexibil și repertoriu ales după invitați.", "provider": {"@type": "MusicGroup", "@id": "https://ioana-balan.ro/#artist", "name": "Ioana Balan", "url": "https://ioana-balan.ro/", "genre": ["Muzică populară", "Muzică de petrecere", "Folclor"], "foundingLocation": {"@type": "Place", "name": "București, România"}, "telephone": "+40722911485", "email": "ioanabalanoficial@gmail.com", "sameAs": ["https://www.facebook.com/ioanabalanoficial", "https://www.instagram.com/ioanabalanoficial/", "https://www.tiktok.com/@ioanabalanmusic", "https://www.youtube.com/channel/UCNTWODu5imMryMhkbbw6vEQ", "https://ro.pinterest.com/ioanabalanoficial/"]}, "availableChannel": {"@type": "ServiceChannel", "servicePhone": {"@type": "ContactPoint", "telephone": "+40722911485", "contactType": "rezervări"}, "serviceUrl": "https://wa.me/40722911485"}}], "h1": "Aniversări, cumetrii, onomastici: muzica pentru o petrecere de familie", "title": "Eveniment privat"}, "elements": [{"id": "even008", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "__globals__": {}