{"meta": {"src": "zona-giurgiu.html", "slug": "giurgiu", "parent": "zone", "noindex": false, "seo_title": "Muzică de Petrecere și Folclor Giurgiu | Nunți și Botezuri | Ioana Balan", "metadesc": "Muzică de petrecere și folclor live pentru nunți și botezuri în județul Giurgiu, la o oră de București: repertoriu muntenesc, sonorizare proprie, fără cazare.", "jsonld": [{"@context": "https://schema.org", "@type": "Service", "name": "Muzică de petrecere și folclor live pentru evenimente în Giurgiu", "serviceType": "Muzică live pentru nuntă, botez și eveniment corporate", "description": "Muzică de petrecere și folclor live pentru nunți, botezuri și evenimente corporate în Giurgiu și în localitățile din județ, cu repertoriu muntenesc și sonorizare proprie, la mai puțin de o oră și jumătate de București.", "areaServed": [{"@type": "City", "name": "Giurgiu"}, {"@type": "AdministrativeArea", "name": "Județul Giurgiu"}], "provider": {"@type": "MusicGroup", "@id": "https://ioana-balan.ro/#artist", "name": "Ioana Balan", "url": "https://ioana-balan.ro/", "genre": ["Muzică populară", "Muzică de petrecere", "Folclor"], "foundingLocation": {"@type": "Place", "name": "București, România"}, "telephone": "+40722911485", "email": "ioanabalanoficial@gmail.com", "sameAs": ["https://www.facebook.com/ioanabalanoficial", "https://www.instagram.com/ioanabalanoficial/", "https://www.tiktok.com/@ioanabalanmusic", "https://www.youtube.com/channel/UCNTWODu5imMryMhkbbw6vEQ", "https://ro.pinterest.com/ioanabalanoficial/"]}, "availableChannel": {"@type": "ServiceChannel", "servicePhone": {"@type": "ContactPoint", "telephone": "+40722911485", "contactType": "rezervări"}, "serviceUrl": "https://wa.me/40722911485"}}], "h1": "La o oră de București: muzică live pentru nunți și botezuri în județul Giurgiu", "title": "Giurgiu"}, "elements": [{"id": "zgiu00c", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "fle