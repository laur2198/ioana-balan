"0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}}, "elements": []}, {"id": "zgiu01c", "elType": "widget", "widgetType": "heading", "settings": {"title": "Trei date operaționale, atât", "header_size": "h2", "title_color": "#E5E2E1", "__globals__": {"title_color": "globals/colors?id=primary", "typography_typography": "globals/typography?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_element_id": "logistica-titlu"}, "elements": []}, {"id": "zgiu01d", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Lista de constrângeri pentru un eveniment în județ e scurtă, iar scurtimea ei e chiar argumentul. Mai jos e tot ce influențează prețul și programul zilei. Singura sumă care variază după localitate e suplimentul de transport: 6 lei/km, aplicat pe traseul dus-întors.</p>", "text_color": "#C6C6C6", "custom_css": "selector p{margin:0}", "__globals__": {"text_color": "globals/colors?id=secondary", "typography_typography": "globals/typography?id=text"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": []}], "isInner": true}, {"id": "zgiu01f", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><div class=\"grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-gutter max-w-4xl\">\n<div class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Distanță</span>\n<p class=\"font-display-lg text-3xl md:text-4xl text-on-surface\">60–90 km</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Din București, variind cu localitatea: nordul județului e mai aproape, malul Dunării mai departe. Sub o oră și jumătate pe DN5 sau pe DN6, pe trasee care nu au tronsoane cu blocaj previzibil în weekend.</p>\n</div>\n<div class=\"glass-card silver-border p-6 md:p-8 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Deplasare</span>\n<p class=\"font-headline-md text-xl md:text-headline-md text-on-surface\">Două drumuri, în aceeași zi</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Primul duce sonorizarea, lumina și schela, cu echipa tehnică; al doilea aduce interpreții și instrumentiștii, după montaj. Ambele încap în ziua evenimentului, fără plecare devreme și fără o zi pierdută înainte.</p>\n</div>\n<div class=\"glass-card silver-border p-6 md:p-8 md:col-span-2 flex flex-col gap-3\">\n<span class=\"font-label-md text-[11px] uppercase tracking-widest text-on-surface-variant\">Cazare</span>\n<p class=\"font-headline-md text-xl md:text-headline-md text-on-surface\">Nu se adaugă cost de cazare</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">După demontare echipa se întoarce în București în aceeași noapte. La 60–90 km lucrul ăsta e realizabil fără să afecteze programul de a doua zi, așa că devizul nu conține nicio noapte de hotel. E diferența de fond față de un județ ca Brașovul sau față de litoral, unde cazarea e obligatorie și se rezervă odată cu data.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Nici kilometrii parcurși între localitățile din listă, în interiorul județului, nu se facturează separat. Din capitolul de deplasare rămâne o singură linie pe deviz, suplimentul de transport.</p>\n</div>\n</div></div>"}, "elements": []}], "isInner": false}, {"id": "zgiu022", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "0", "right": "24", "bottom": "0", "left": "24", "isLinked": false}}, "elements": [{"id": "zgiu021", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"zona-divider\"></div>"}, "elements": []}], "isInner": false}, {"id": "zgiu024", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}}, "elements": [{"id": "zgiu023", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><div class=\"max-w-3xl mx-auto glass-card silver-border p-6 md:p-12 text-center flex flex-col items-center gap-5\">\n<span class=\"font-label-md text-label-md text-primary uppercase tracking-[0.2em]\">Pachete</span>\n<h2 class=\"font-headline-lg text-2xl md:text-headline-lg leading-tight\" id=\"pachete-titlu\">Pachete și prețuri</h2>\n<p class=\"font-body-lg text-base md:text-body-lg text-on-surface-variant\">Grila e comună pentru toate zonele, cu aceleași configurații. Pentru județul Giurgiu diferența e în minus: intră doar transportul, nu și o noapte de cazare. Tarifele de sâmbătă și de duminică rămân distincte, ca peste tot.</p>\n\n\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Fără noapte de hotel, drumul până la Comana sau Bolintin-Vale arată la fel indiferent de eveniment. Diferă ordinea serii, descrisă separat pentru <a class=\"text-primary underline underline-offset-4 hover:text-white transition-colors\" href=\"/botez/\">botez</a>, pentru <a class=\"text-primary underline underline-offset-4 hover:text-white transition-colors\" href=\"/nunta/\">nuntă</a>, pentru <a class=\"text-primary underline underline-offset-4 hover:text-white transition-colors\" href=\"/corporate/\">o gală sau o petrecere de Crăciun a firmei</a> și pentru <a class=\"text-primary underline underline-offset-4 hover:text-white transition-colors\" href=\"/eveniment-privat/\">o onomastică sau o zi de naștere rotundă</a>.</p>\n<div class=\"motif-rule max-w-[180px] w-full\"><span class=\"motif-rule__gem zona-gem\"></span></div>\n<div class=\"flex flex-col sm:flex-row gap-4 w-full sm:w-auto\">\n<a class=\"inline-block text-center whitespace-nowrap bg-accent text-white px-8 md:px-10 py-4 uppercase font-label-md text-label-md tracking-widest hover:bg-accent-hover transition-colors w-full sm:w-auto\" href=\"/oferte/\">Vezi toate pachetele</a>\n<a class=\"btn-secundar-zona inline-block text-center whitespace-nowrap text-on-surface bg-transparent px-8 md:px-10 py-4 uppercase font-label-md text-label-md tracking-widest hover:bg-white/5 transition-colors w-full sm:w-auto\" href=\"/contact/\">Cere ofertă</a>\n</div>\n</div></div>"}, "elements": []}], "isInner": false}, {"id": "zgiu026", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "0", "right": "64", "bottom": "0", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "0", "right": "24", "bottom": "0", "left": "24", "isLinked": false}}, "elements": [{"id": "zgiu025", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"zona-divider\"></div>"}, "elements": []}], "isInner": false}, {"id": "zgiu031", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1072, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "background_background": "classic", "background_color": "#131313", "__globals__": {"background_color": "globals/colors?id=surface"}, "custom_css": "selector{background-color:#131313}", "padding": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "80", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}}, "elements": [{"id": "zgiu029", "elType": "container", "settings": {"container_type": "flex", "content_width": "full", "flex_direction": "column", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "width": {"unit": "px", "size": 768, "sizes": []}, "width_mobile": {"unit": "%", "size": 100, "sizes": []}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "48", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "48", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "32", "left": "0", "isLinked": false}, "custom_css": "selector{max-width:100%}"}, "elements": [{"id": "zgiu027", "elType": "widget", "widgetType": "heading", "settings": {"title": "Întrebări", "header_size": "div", "title_color": "#C6C6C6", "typography_typography": "custom", "typography_font_family": "Inter", "typography_font_size": {"unit": "px", "size": 14, "sizes": []}, "typography_font_weight": "600", "typography_text_transform": "uppercase", "typography_letter_spacing": {"unit": "em", "size": 0.2, "sizes": []}, "typography_line_height": {"unit": "px", "size": 20, "sizes": []}, "__globals__": {"title_color": "globals/colors?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "16", "left": "0", "isLinked": false}}, "elements": []}, {"id": "zgiu028", "elType": "widget", "widgetType": "heading", "settings": {"title": "Comune de pe Dunăre, invitați din București, niciun hotel pe deviz", "header_size": "h2", "title_color": "#E5E2E1", "__globals__": {"title_color": "globals/colors?id=primary", "typography_typography": "globals/typography?id=secondary"}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "_element_id": "faq-titlu"}, "elements": []}], "isInner": true}, {"id": "zgiu02f", "elType": "container", "settings": {"container_type": "flex", "content_width": "full", "flex_direction": "column", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "width": {"unit": "px", "size": 768, "sizes": []}, "width_mobile": {"unit": "%", "size": 100, "sizes": []}, "custom_css": "selector{max-width:100%}", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": [{"id": "zgiu02a", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"faq-item\"><details open><summary aria-expanded=\"true\"><h3>Veniți și în comunele din județ, nu doar în orașul Giurgiu?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 -960 960 960\" fill=\"currentColor\"><path d=\"M480-357.85 253.85-584l32.61-32.61L480-423.08l193.54-193.53L706.15-584 480-357.85Z\"/></svg></summary><div class=\"faq-item__answer\"><p>Da, toate cele unsprezece localități de mai sus intră în aceeași acoperire. Între o comună din nordul județului și una de pe malul Dunării sunt aproximativ treizeci de minute de drum, ceea ce nu modifică structura ofertei.</p>\n<p>Ce contează mai mult decât localitatea e locația propriu-zisă: dacă e sală, cort sau curte, ce curent există acolo și dacă accesul permite descărcarea aproape de punctul de montaj. Pe astea le lămurim la rezervare.</p></div></details></div>", "custom_css": "selector{margin-bottom:16px}selector h3{margin:0;padding-right:16px;font-family:\"EB Garamond\",Georgia,serif;font-size:16px;font-weight:500;line-height:1.375;color:var(--e-global-color-primary)}@media(min-width:768px){selector h3{font-size:24px}}selector .faq-item__answer{font-family:Inter,sans-serif;font-size:16px;line-height:1.6}selector .faq-item__answer p{margin:0}selector .faq-item__answer p+p{margin-top:12px}"}, "elements": []}, {"id": "zgiu02b", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"faq-item\"><details><summary aria-expanded=\"false\"><h3>Trebuie să plătim și cazarea echipei?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 -960 960 960\" fill=\"currentColor\"><path d=\"M480-357.85 253.85-584l32.61-32.61L480-423.08l193.54-193.53L706.15-584 480-357.85Z\"/></svg></summary><div class=\"faq-item__answer\"><p>Nu. La distanța asta echipa se întoarce acasă după demontare, în aceeași noapte, deci pe deviz nu apare nicio linie de hotel. Întrebarea are sens pentru județele unde drumul e de câteva ore și unde cazarea se rezervă odată cu data; aici, nu.</p>\n<p>Din capitolul de deplasare rămâne doar suplimentul de transport, calculat dus-întors, la aceiași 6 lei/km din secțiunea de logistică de mai sus.</p></div></details></div>", "custom_css": "selector{margin-bottom:16px}selector h3{margin:0;padding-right:16px;font-family:\"EB Garamond\",Georgia,serif;font-size:16px;font-weight:500;line-height:1.375;color:var(--e-global-color-primary)}@media(min-width:768px){selector h3{font-size:24px}}selector .faq-item__answer{font-family:Inter,sans-serif;font-size:16px;line-height:1.6}selector .faq-item__answer p{margin:0}selector .faq-item__answer p+p{margin-top:12px}"}, "elements": []}, {"id": "zgiu02c", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"faq-item\"><details><summary aria-expanded=\"false\"><h3>Sala e mică sau evenimentul e sub cort — de ce aveți nevoie de la locație?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 -960 960 960\" fill=\"currentColor\"><path d=\"M480-357.85 253.85-584l32.61-32.61L480-423.08l193.54-193.53L706.15-584 480-357.85Z\"/></svg></summary><div class=\"faq-item__answer\"><p>Într-o sală mică de comună sau sub un cort ridicat în curte, contează întâi dimensiunea spațiului. Configurația de sonorizare se alege după volumul sălii și după numărul de invitați; într-un spațiu mic o instalație supradimensionată nu sună mai bine, sună mai prost.</p>\n<p>Apoi, accesul: sala sau cortul trebuie să fie deschise cu 4–5 ore înainte de începerea evenimentului, cât îi trebuie montajului. Iar dacă evenimentul e sub cort, mai e o condiție: echipamentul are nevoie de acoperire în caz de ploaie, inclusiv pupitrul, nu doar boxele.</p></div></details></div>", "custom_css": "selector{margin-bottom:16px}selector h3{margin:0;padding-right:16px;font-family:\"EB Garamond\",Georgia,serif;font-size:16px;font-weight:500;line-height:1.375;color:var(--e-global-color-primary)}@media(min-width:768px){selector h3{font-size:24px}}selector .faq-item__answer{font-family:Inter,sans-serif;font-size:16px;line-height:1.6}selector .faq-item__answer p{margin:0}selector .faq-item__answer p+p{margin-top:12px}"}, "elements": []}, {"id": "zgiu02d", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"faq-item\"><details><summary aria-expanded=\"false\"><h3>Cât de târziu se mai poate prinde o dată la Giurgiu?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 -960 960 960\" fill=\"currentColor\"><path d=\"M480-357.85 253.85-584l32.61-32.61L480-423.08l193.54-193.53L706.15-584 480-357.85Z\"/></svg></summary><div class=\"faq-item__answer\"><p>Regula de sezon e aceeași ca oriunde — sâmbetele din mai până în septembrie pleacă primele. Ce diferă la un județ-satelit al Bucureștiului e că un eveniment de aici nu consumă ziua întreagă, cum se întâmplă acolo unde se adaugă ore de drum și o noapte de hotel, așa că rămân mai multe ferestre deschise târziu în calendar.</p>\n<p>În termeni practici, o cerere făcută cu câteva săptămâni înainte are aici șanse reale, spre deosebire de zonele îndepărtate. Merită întrebat chiar și așa, pe o dată concretă: răspunsul spune dacă e liberă și cât costă fiecare pachet.</p></div></details></div>", "custom_css": "selector{margin-bottom:16px}selector h3{margin:0;padding-right:16px;font-family:\"EB Garamond\",Georgia,serif;font-size:16px;font-weight:500;line-height:1.375;color:var(--e-global-color-primary)}@media(min-width:768px){selector h3{font-size:24px}}selector .faq-item__answer{font-family:Inter,sans-serif;font-size:16px;line-height:1.6}selector .faq-item__answer p{margin:0}selector .faq-item__answer p+p{margin-top:12px}"}, "elements": []}, {"id": "zgiu02e", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"faq-item\"><details><summary aria-expanded=\"false\"><h3>Jumătate dintre invitați vin din București, jumătate din județ. Cum se împarte programul?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 -960 960 960\" fill=\"currentColor\"><path d=\"M480-357.85 253.85-584l32.61-32.61L480-423.08l193.54-193.53L706.15-584 480-357.85Z\"/></svg></summary><div class=\"faq-item__answer\"><p>Nu se împarte în două blocuri, tocmai pentru că fondul muzical e comun între Capitală și sudul Munteniei. Împărțirea se face pe intensitate, nu pe origine: momentele de folclor muntenesc stau devreme, cât sala e la mese și ascultă, iar petrecerea și muzica ușoară preiau pe măsură ce ringul se umple.</p>\n<p>Dacă totuși există un grup de invitați dintr-o altă regiune a țării, spuneți-ne la discuția de organizare. Se adaugă câteva piese dedicate lor, nu un capitol întreg de program.</p></div></details></div>", "custom_css": "selector{margin-bottom:16px}selector h3{margin:0;padding-right:16px;font-family:\"EB Garamond\",Georgia,serif;font-size:16px;font-weight:500;line-height:1.375;color:var(--e-global-color-primary)}@media(min-width:768px){selector h3{font-size:24px}}selector .faq-item__answer{font-family:Inter,sans-serif;font-size:16px;line-height:1.6}selector .faq-item__answer p{margin:0}selector .faq-item__answer p+p{margin-top:12px}"}, "elements": []}], "isInner": true}, {"id": "zgiu030", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><div class=\"mt-10 md:mt-12\">\n<a class=\"font-label-md text-label-md uppercase tracking-widest text-primary hover:text-white transition-colors inline-flex items-center gap-2 min-h-[44px]\" href=\"/faq/\">Vezi toate întrebările frecvente <svg aria-hidden=\"true\" class=\"text-[18px]\" fill=\"currentColor\" height=\"1em\" style=\"vertical-align:-.125em\" viewbox=\"0 -960 960 960\" width=\"1em\"><path d=\"M693.69-457.31H180v-45.38h513.69L448.39-748 480-780l300 300-300 300-31.61-32 245.3-245.31Z\"></path></svg></a>\n</div></div>"}, "elements": []}], "isInner": false}, {"id": "zgiu035", "elType": "container", "settings": {"container_type": "flex", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 544, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "flex_align_items": "center", "background_background": "classic", "background_color": "#1C1B1B", "__globals__": {"background_color": "globals/colors?id=surfacealt"}, "custom_css": "selector{background-color:#1C1B1B}selector{border-top:1px solid rgba(68,71,72,.1)}selector{text-align:center}", "padding": {"unit": "px", "top": "96", "right": "64", "bottom": "96", "left": "64", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "96", "right": "64", "bottom": "96", "left": "64", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "64", "right": "24", "bottom": "64", "left": "24", "isLinked": false}}, "elements": [{"id": "zgiu032", "elType": "widget", "widgetType": "heading", "settings": {"title": "Trei informații și primiți prețul final", "header_size": "h2", "title_color": "#E5E2E1", "__globals__": {"title_color": "globals/colors?id=primary", "typography_typography": "globals/typography?id=primary"}, "align": "center", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "20", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "20", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "20", "left": "0", "isLinked": false}}, "elements": []}, {"id": "zgiu033", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Localitatea, data și câți invitați estimați — atât e nevoie pentru un preț ferm, nu pentru o estimare. Îl primiți cu transportul deja inclus și fără linie de cazare, iar pachetul îl alegeți voi.</p>", "text_color": "#C6C6C6", "custom_css": "selector p{margin:0}", "__globals__": {"text_color": "globals/colors?id=secondary", "typography_typography": "globals/typography?id=quote"}, "align": "center", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "40", "left": "0", "isLinked": false}, "_margin_tablet": {"unit": "px", "top": "0", "right": "0", "bottom": "40", "left": "0", "isLinked": false}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "40", "left": "0", "isLinked": false}}, "elements": []}, {"id": "zgiu034", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ib-tw\"><div class=\"flex flex-col sm:flex-row justify-center gap-4\">\n<a class=\"inline-block whitespace-nowrap bg-accent text-white px-8 md:px-10 py-4 md:py-5 uppercase font-label-md text-label-md tracking-widest hover:bg-accent-hover transition-colors w-full sm:w-auto\" href=\"https://wa.me/40722911485?text=Bun%C4%83%20ziua%21%20Organizez%20un%20eveniment%20%C3%AEn%20jude%C8%9Bul%20Giurgiu%20%C8%99i%20a%C8%99%20dori%20disponibilitatea%20%C8%99i%20pre%C8%9Bul%20final.\" rel=\"noopener\" target=\"_blank\">Rezervă pe WhatsApp</a>\n<a class=\"btn-secundar-zona inline-block whitespace-nowrap text-center text-on-surface bg-transparent px-8 md:px-10 py-4 md:py-5 uppercase font-label-md text-label-md tracking-widest hover:bg-white/5 transition-colors w-full sm:w-auto\" href=\"/contact/\">Formular de contact</a>\n</div></div>"}, "elements": []}], "isInner": false}]}